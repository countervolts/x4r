+bool SameFile(const std::string& a, const std::string& b)
+{
+    FILE* fa = nullptr; FILE* fb = nullptr;
+    if (fopen_s(&fa, a.c_str(), "rb") != 0 || !fa) return false;
+    if (fopen_s(&fb, b.c_str(), "rb") != 0 || !fb) { fclose(fa); return false; }
+    bool same = true;
+    char x[65536], y[65536];
+    for (;;)
+    {
+        size_t nx = fread(x, 1, sizeof x, fa), ny = fread(y, 1, sizeof y, fb);
+        if (nx != ny || memcmp(x, y, nx)) { same = false; break; }
+        if (!nx) break;
+    }
+    fclose(fa); fclose(fb);
+    return same;
+}
