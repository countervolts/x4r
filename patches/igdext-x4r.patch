+void STDMETHODCALLTYPE h_CopyDescsSimple(ID3D12Device* d, UINT n, D3D12_CPU_DESCRIPTOR_HANDLE dst, D3D12_CPU_DESCRIPTOR_HANDLE src, D3D12_DESCRIPTOR_HEAP_TYPE t)
+{
+    if (t == D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV)
+    {
+        std::lock_guard<std::mutex> l(g_mx);
+        for (UINT i = 0; i < n; ++i) { auto it = g_views.find(src.ptr + i * g_inc); if (it != g_views.end()) g_views[dst.ptr + i * g_inc] = it->second; else g_views.erase(dst.ptr + i * g_inc); }
+    }
