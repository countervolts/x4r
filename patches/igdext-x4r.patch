+// Plugin mode: OptiScaler loads <game>\plugins\x4r.asi (this same DLL) at startup, before the game touches DXGI or XeSS.
+// It does what a manual install would: puts the shim where XeSS looks for igdext64.dll (the prefix's system32, a path
+// Proton fixes), and gives the Intel vendor id to the game's GPU through dxvk.conf so XeSS enables its XMX path.
+void InstallFromPlugin(const std::string& self)
+{
+    char sys[MAX_PATH] = {};
+    GetSystemDirectoryA(sys, MAX_PATH);
+    const std::string dest = std::string(sys) + "\\igdext64.dll", backup = dest + ".x4r-backup";
+    std::string note = "ok";
+    if (!SameFile(self, dest))
+    {
+        if (GetFileAttributesA(dest.c_str()) != INVALID_FILE_ATTRIBUTES && GetFileAttributesA(backup.c_str()) == INVALID_FILE_ATTRIBUTES)
+            CopyFileA(dest.c_str(), backup.c_str(), TRUE);        // Proton's own igdext64.dll
+        DeleteFileA(dest.c_str());                                 // a symlink into Proton would otherwise be written through
+        if (!CopyFileA(self.c_str(), dest.c_str(), FALSE)) note = "could not copy the shim into " + dest;
+    }
+    char exe[MAX_PATH] = {};
+    GetModuleFileNameA(nullptr, exe, MAX_PATH);
+    std::string conf = exe;
+    conf.resize(conf.find_last_of('\\') + 1);
+    conf += "dxvk.conf";
+    std::string have;
+    if (FILE* f = nullptr; fopen_s(&f, conf.c_str(), "rb") == 0 && f) { char b[4096]; size_t n; while ((n = fread(b, 1, sizeof b, f)) > 0) have.append(b, n); fclose(f); }
+    if (have.find("# x4r begin") == std::string::npos)
+    {
+        if (!have.empty() && have.back() != '\n') have += "\n";
+        have += "# x4r begin\ndxgi.customVendorId = 8086\ndxgi.customDeviceId = e20b\ndxgi.hideAmdGpu = False\n# x4r end\n";
+        FILE* f = nullptr;
+        if (fopen_s(&f, conf.c_str(), "wb") == 0 && f) { fwrite(have.data(), 1, have.size(), f); fclose(f); }
+        else note += "; could not write " + conf;
+    }
+    TraceF("x4r: plugin install: %s", note.c_str());
+    if (FILE* f = nullptr; fopen_s(&f, (g_dir + "\\installation-status.txt").c_str(), "wb") == 0 && f) { fprintf(f, "%s\n", note.c_str()); fclose(f); }
+}
+
+// DllMain: locate the runtime folder (<dll folder>\x4r, or X4R_DIR set by the plugin instance), falling back to C:\x4r.
+// Returns true when this DLL was loaded as the x4r.asi plugin (it then only installs itself and stays idle).
+extern "C" bool X4rInit(HMODULE self)
+{
+    char p[MAX_PATH] = {};
+    char env[MAX_PATH] = {};
+    if (GetEnvironmentVariableA("X4R_DIR", env, MAX_PATH) && DirExists(env)) { g_dir = env; return false; }
+    if (!GetModuleFileNameA(self, p, MAX_PATH)) return false;
+    const std::string path = p;
+    char* slash = strrchr(p, '\\');
+    if (!slash) return false;
+    *slash = 0;
+    std::string cand = std::string(p) + "\\x4r";
+    if (DirExists(std::string(p) + "\\dxil")) cand = p;      // release layout: <game>\x4r\x4r.asi beside its kernels
+    if (DirExists(cand)) g_dir = cand;
+    const size_t n = path.size();
+    const bool asi = n > 4 && _stricmp(path.c_str() + n - 4, ".asi") == 0;
+    if (asi && DirExists(cand))
+    {
+        SetEnvironmentVariableA("X4R_DIR", cand.c_str());          // the copy in system32 finds the kernels through this
+        SelectOverrides();   // as early as the plugin loads: vkd3d-proton only sees VKD3D_SHADER_OVERRIDE if it is set before it initialises
+        if (IniValue("Trace") == "true") SetEnvironmentVariableA("IGDEXT_TRACE", "1");   // x4r.ini: per-kernel GPU times in C:\\igdext_trace.log (inside the prefix)
+        InstallFromPlugin(path);
+    }
+    return asi;
+}
+
+// 1 on an x4r install (the ANV self-test does not apply), 0 without the x4r runtime (upstream behaviour). A game whose
+// XeSS has kernels we did not translate does not fall back to DP4a: the pipeline creation fails (X4rKernelFailed).
+extern "C" int X4rGate()
+{
+    if (!DirExists(g_dir + "\\dxil")) return 0;
+    HMODULE m = GetModuleHandleA("libxess.dll");
+    char path[MAX_PATH];
+    if (m && GetModuleFileNameA(m, path, MAX_PATH))
+    {
+        DWORD h = 0, n = GetFileVersionInfoSizeA(path, &h);
+        std::vector<char> blob(n ? n : 1);
+        VS_FIXEDFILEINFO* fi = nullptr; UINT len = 0;
+        if (n && GetFileVersionInfoA(path, 0, n, blob.data()) && VerQueryValueA(blob.data(), "\\", (void**)&fi, &len) && fi)
+        {
+            char have[64]; snprintf(have, sizeof have, "%u.%u.%u.%u", HIWORD(fi->dwFileVersionMS), LOWORD(fi->dwFileVersionMS), HIWORD(fi->dwFileVersionLS), LOWORD(fi->dwFileVersionLS));
+            g_xessVer = have;
+        }
+    }
+    return 1;
+}
+
+// A CM kernel without a translation (other XeSS version, translation missing or rejected by the driver): count it and
+// let the caller fail the pipeline, so the problem shows up as an XeSS error and in status.txt, never as noise or a silent fallback.
+extern "C" void X4rKernelFailed(unsigned long long kernelHash, const char* why)
+{
+    ++g_failed;
+    if (FILE* f = nullptr; fopen_s(&f, (g_dir + "\\failed-kernels.txt").c_str(), "ab") == 0 && f) { fprintf(f, "%016llx %s\n", kernelHash, why); fclose(f); }
+    TraceF("x4r: FAILED kernel %016llx: %s (XeSS library %s, runtime expects %s)", kernelHash, why, g_xessVer.c_str(), IniValue("XessVersion").c_str());
+    WriteStatus(0);
+}
+
+extern "C" void X4rHookDevice(ID3D12Device* dev)
+{
+    static std::once_flag once;
+    std::call_once(once, [dev] {
+        SelectOverrides();
+        void** vtbl = *(void***)dev;
+        // ID3D12Device vtable: 16 CreateRootSignature, 18 CreateShaderResourceView, 19 CreateUnorderedAccessView
+        Patch(vtbl, 16, (void*)h_CreateRootSignature, (void**)&o_CreateRootSignature);
+        Patch(vtbl, 18, (void*)h_CreateSRV, (void**)&o_CreateSRV);
+        Patch(vtbl, 19, (void*)h_CreateUAV, (void**)&o_CreateUAV);
+        char want[1024] = {};
+        if (GetEnvironmentVariableA("X4R_DUMP", want, sizeof want))
+        {
+            for (char* t = strtok(want, ","); t; t = strtok(nullptr, ","))
+            { unsigned long long kh; int n; if (sscanf(t, "%llx:%d", &kh, &n) == 2) g_dumpWant[kh][n] = true; }
+            g_dumpOn = !g_dumpWant.empty();
+        }
+        if (g_dumpOn)
+        {
+            g_dev = dev; g_inc = dev->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+            CreateDirectoryA((g_dir + "\\dump").c_str(), nullptr);
+            // ID3D12Device vtable: 14 CreateDescriptorHeap, 17 CreateConstantBufferView, 23 CopyDescriptors, 24 CopyDescriptorsSimple,
+            // 27 CreateCommittedResource, 29 CreatePlacedResource
+            Patch(vtbl, 14, (void*)h_CreateHeap, (void**)&o_CreateHeap);
+            Patch(vtbl, 17, (void*)h_CreateCBV, (void**)&o_CreateCBV);
+            Patch(vtbl, 23, (void*)h_CopyDescs, (void**)&o_CopyDescs);
+            Patch(vtbl, 24, (void*)h_CopyDescsSimple, (void**)&o_CopyDescsSimple);
+            Patch(vtbl, 27, (void*)h_CreateCommitted, (void**)&o_CreateCommitted);
+            Patch(vtbl, 29, (void*)h_CreatePlaced, (void**)&o_CreatePlaced);
+            TraceF("x4r: dump mode for %zu kernels into %s\\dump", g_dumpWant.size(), g_dir.c_str());
+        }
+        // ID3D12GraphicsCommandList vtable: 14 Dispatch, 25 SetPipelineState (shared by all lists, so one throwaway list is enough)
+        ID3D12CommandAllocator* al = nullptr; ID3D12GraphicsCommandList* cl = nullptr;
+        if (SUCCEEDED(dev->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, __uuidof(ID3D12CommandAllocator), (void**)&al)) &&
+            SUCCEEDED(dev->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, al, nullptr, __uuidof(ID3D12GraphicsCommandList), (void**)&cl)))
+        {
+            void** lv = *(void***)cl;
+            Patch(lv, 25, (void*)h_SetPSO, (void**)&o_SetPSO);
+            Patch(lv, 14, (void*)h_Dispatch, (void**)&o_Dispatch);
+            Patch(lv, 9, (void*)h_Close, (void**)&o_Close);
+            Patch(lv, 10, (void*)h_Reset, (void**)&o_Reset);
+            Patch(lv, 11, (void*)h_ClearState, (void**)&o_ClearState);
+            if (g_dumpOn)
+            {
+                // 29 SetComputeRootSignature, 31 SetComputeRootDescriptorTable, 33/35 SetComputeRoot32BitConstant(s), 37/39/41 root CBV/SRV/UAV
+                Patch(lv, 29, (void*)h_SetRS, (void**)&o_SetRS);
+                Patch(lv, 15, (void*)h_CopyBuf, (void**)&o_CopyBuf);   // CopyBufferRegion
+                Patch(lv, 17, (void*)h_CopyRes, (void**)&o_CopyRes);   // CopyResource
+                Patch(lv, 31, (void*)h_SetTable, (void**)&o_SetTable);
+                Patch(lv, 33, (void*)h_SetConst, (void**)&o_SetConst);
+                Patch(lv, 35, (void*)h_SetConsts, (void**)&o_SetConsts);
+                Patch(lv, 37, (void*)h_SetRootCbv, (void**)&o_SetRootCbv);
+                Patch(lv, 39, (void*)h_SetRootSrv, (void**)&o_SetRootSrv);
+                Patch(lv, 41, (void*)h_SetRootUav, (void**)&o_SetRootUav);
+            }
+            if (!g_timingInit) InitTiming(dev);
+            o_Close(cl);
+        }
+        if (cl) cl->Release();
+        if (al) al->Release();
+        g_frameSyncRequested = IniValue("FrameSync") == "true" || GetEnvironmentVariableA("X4R_FRAME_SYNC", nullptr, 0) > 0;
+        g_frameSync = g_frameSyncRequested;
+        if (g_frameSync) {
+            ID3D12CommandQueue* q = nullptr; D3D12_COMMAND_QUEUE_DESC desc = {}; desc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+            if (SUCCEEDED(dev->CreateCommandQueue(&desc, __uuidof(ID3D12CommandQueue), (void**)&q))) {
+                void** qv = *(void***)q;
+                Patch(qv, 10, (void*)h_ExecuteLists, (void**)&o_ExecuteLists);
+                Patch(qv, 15, (void*)h_QueueWait, (void**)&o_QueueWait);
+                if (!o_ExecuteLists || !o_QueueWait || qv[10] != (void*)h_ExecuteLists || qv[15] != (void*)h_QueueWait) g_frameSync = false;
+                q->Release(); TraceF("x4r: frame-sync trial enabled");
+            } else { g_frameSync = false; TraceF("x4r: frame-sync queue hook unavailable"); }
+        }
+        WriteFrameSyncReport(nullptr, 0, nullptr);
+        TraceF("x4r: device %p hooked", dev);
+    });
+}
+
+unsigned long long X4rRootSigHash(ID3D12RootSignature* rs)
+{
+    std::lock_guard<std::mutex> l(g_mx);
+    auto it = g_rsHash.find(rs);
+    return it == g_rsHash.end() ? 0 : it->second;
+}
+
+// translated kernel for this CM kernel hash, if the Linux side built one (cached for the process lifetime)
+bool X4rKernelBytecode(unsigned long long kernelHash, D3D12_SHADER_BYTECODE* out)
+{
+    static std::mutex m;
+    static std::map<unsigned long long, std::vector<char>> cache;
+    std::lock_guard<std::mutex> l(m);
+    auto it = cache.find(kernelHash);
+    if (it == cache.end())
+    {
+        std::vector<char> data;
+        char path[MAX_PATH]; snprintf(path, sizeof(path), "%s\\dxil\\%016llx.dxil", g_dir.c_str(), kernelHash);
+        if (FILE* f = nullptr; fopen_s(&f, path, "rb") == 0 && f)
+        {
+            fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+            if (n > 0) { data.resize(n); if (fread(data.data(), 1, n, f) != (size_t)n) data.clear(); }
+            fclose(f);
+        }
+        it = cache.emplace(kernelHash, std::move(data)).first;
+    }
+    if (it->second.empty()) return false;
+    if (!g_kmode.count(kernelHash))
+    {
+        unsigned long long h = 14695981039346656037ull;      // vkd3d names a shader override after the FNV-1 of the DXIL
+        for (char c : it->second) { h *= 1099511628211ull; h ^= (unsigned char)c; }
+        char ov[MAX_PATH]; snprintf(ov, sizeof ov, "%s\\%016llx.spv", g_ovrDir.c_str(), h);
+        g_kmode[kernelHash] = !g_ovrDir.empty() && GetFileAttributesA(ov) != INVALID_FILE_ATTRIBUTES;
+    }
+    out->pShaderBytecode = it->second.data();
+    out->BytecodeLength = it->second.size();
+    return true;
+}
+
+// capture mode: which root signature goes with which kernel (input of the Linux-side translation)
+extern "C" void X4rCaptureNote(unsigned long long kernelHash, unsigned long long rsHash)
+{
+    static std::mutex m; static std::map<unsigned long long, bool> seen;
+    std::lock_guard<std::mutex> l(m);
+    if (seen[kernelHash]) return;
+    seen[kernelHash] = true;
+    if (FILE* f = nullptr; fopen_s(&f, (g_dir + "\\captured-kernels.txt").c_str(), "ab") == 0 && f) { fprintf(f, "%016llx %016llx\n", kernelHash, rsHash); fclose(f); }
+}
+
+extern "C" void X4rNotePipeline(ID3D12PipelineState* pso, unsigned long long kernelHash)
+{
+    std::lock_guard<std::mutex> l(g_mx);
+    g_psoHash[pso] = kernelHash;
+}
