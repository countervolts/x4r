+        for (UINT i = 0; i < nd; ++i) for (UINT k = 0; k < (dn ? dn[i] : 1); ++k) dst.push_back(ds[i].ptr + k * g_inc);
+        std::lock_guard<std::mutex> l(g_mx);
+        for (size_t i = 0; i < src.size() && i < dst.size(); ++i) { auto it = g_views.find(src[i]); if (it != g_views.end()) g_views[dst[i]] = it->second; else g_views.erase(dst[i]); }
