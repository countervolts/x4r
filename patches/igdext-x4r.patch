+// Reversible frame-overlap trial. Preserve normal submission when disabled.
+// Pending GPU queue waits may depend on CPU submissions which have not happened
+// yet: never block the submitting CPU in that case. Bound every other CPU wait.
+using PFN_ExecuteLists = void(STDMETHODCALLTYPE*)(ID3D12CommandQueue*, UINT, ID3D12CommandList* const*);
+using PFN_QueueWait = HRESULT(STDMETHODCALLTYPE*)(ID3D12CommandQueue*, ID3D12Fence*, UINT64);
+PFN_ExecuteLists o_ExecuteLists;
+PFN_QueueWait o_QueueWait;
+struct FrameQueue {
+    Microsoft::WRL::ComPtr<ID3D12CommandQueue> queue;
+    Microsoft::WRL::ComPtr<ID3D12Fence> fence;
+    std::vector<std::pair<Microsoft::WRL::ComPtr<ID3D12Fence>, UINT64>> waits;
+    std::mutex mutex;
+    HANDLE event = nullptr;
+    UINT64 serial = 0;
+    ~FrameQueue() { if (event) CloseHandle(event); }
+};
+std::mutex g_queueMx;
+std::map<ID3D12CommandQueue*, std::shared_ptr<FrameQueue>> g_frameQueues;
+std::shared_ptr<FrameQueue> FrameQueueFor(ID3D12CommandQueue* q)
+{
+    std::lock_guard<std::mutex> lock(g_queueMx);
+    auto& s = g_frameQueues[q];
+    if (!s) { s = std::make_shared<FrameQueue>(); s->queue = q; }
+    return s;
+}
+HRESULT STDMETHODCALLTYPE h_QueueWait(ID3D12CommandQueue* q, ID3D12Fence* f, UINT64 value)
+{
+    if (!g_frameSync) return o_QueueWait(q, f, value);
+    auto s = FrameQueueFor(q);
+    std::lock_guard<std::mutex> lock(s->mutex);
+    HRESULT hr = o_QueueWait(q, f, value);
+    if (SUCCEEDED(hr) && f->GetCompletedValue() < value) {
+        Microsoft::WRL::ComPtr<ID3D12Fence> keep = f; s->waits.emplace_back(std::move(keep), value);
+    }
+    return hr;
+}
+void STDMETHODCALLTYPE h_ExecuteLists(ID3D12CommandQueue* q, UINT count, ID3D12CommandList* const* lists)
+{
+    if (!g_frameSync) { o_ExecuteLists(q, count, lists); return; }
+    std::vector<bool> marked(count, false); bool any = false;
+    { std::lock_guard<std::mutex> lock(g_mx);
+      for (UINT i = 0; i < count; ++i) { auto it = g_xessLists.find(lists[i]); marked[i] = it != g_xessLists.end() && it->second; any |= marked[i]; } }
+    if (!any) { o_ExecuteLists(q, count, lists); return; }
+    auto s = FrameQueueFor(q);
+    std::lock_guard<std::mutex> lock(s->mutex);
+    // Give already-submitted upstream GPU work a short chance to finish. A
+    // fence which needs a later CPU submission remains unresolved: skip rather
+    // than deadlocking that submitting thread.
+    const ULONGLONG deadline = GetTickCount64() + 50;
+    do {
+        s->waits.erase(std::remove_if(s->waits.begin(), s->waits.end(), [](const auto& w) { return w.first->GetCompletedValue() >= w.second; }), s->waits.end());
+        if (s->waits.empty() || GetTickCount64() >= deadline) break;
+        Sleep(1);
+    } while (true);
+    if (!s->waits.empty()) {
+        ++g_syncSkipped; TraceF("x4r: frame-sync skipped: unresolved GPU queue wait, queue %p", q);
+        WriteFrameSyncReport(q, s->serial, nullptr);
+        o_ExecuteLists(q, count, lists); return;
+    }
+    if (!s->fence) {
+        Microsoft::WRL::ComPtr<ID3D12Device> d;
+        if (FAILED(q->GetDevice(__uuidof(ID3D12Device), (void**)d.GetAddressOf())) ||
+            FAILED(d->CreateFence(0, D3D12_FENCE_FLAG_NONE, __uuidof(ID3D12Fence), (void**)s->fence.GetAddressOf())) ||
+            !(s->event = CreateEventA(nullptr, FALSE, FALSE, nullptr))) {
+            g_frameSync = false; TraceF("x4r: frame-sync disabled: fence/event creation failed");
+            WriteFrameSyncReport(q, s->serial, nullptr);
+            o_ExecuteLists(q, count, lists); return;
+        }
+    }
+    for (UINT i = 0; i < count; ++i) {
+        o_ExecuteLists(q, 1, &lists[i]);
+        if (!marked[i] || !g_frameSync) continue;
+        const UINT64 value = ++s->serial;
+        HRESULT hr = q->Signal(s->fence.Get(), value);
+        if (SUCCEEDED(hr)) hr = s->fence->SetEventOnCompletion(value, s->event);
+        if (FAILED(hr) || WaitForSingleObject(s->event, 2000) != WAIT_OBJECT_0) {
+            ++g_syncTimeouts; g_frameSync = false;
+            TraceF("x4r: frame-sync disabled: fence wait failed/timed out, queue %p serial %llu", q, (unsigned long long)value);
+            WriteFrameSyncReport(q, value, lists[i]);
+        } else {
+            const auto done = ++g_syncCompleted;
+            if (done <= 20 || done % 120 == 0) {
+                TraceF("x4r: frame-sync completed %llu queue %p serial %llu list %p", done, q, (unsigned long long)value, lists[i]);
+                WriteFrameSyncReport(q, value, lists[i]);
+            }
+        }
+    }
+}
+
+constexpr int kRing = 8, kMaxDisp = 640;            // frames in flight x dispatches per frame
+ID3D12QueryHeap* g_qheap = nullptr;
+ID3D12Resource* g_qread = nullptr;
+UINT64* g_qmap = nullptr;
+double g_tsFreq = 1e9;
+struct Slot { int count = 0; unsigned long long hash[kMaxDisp] = {}; bool resolved = false; bool used = false; };
+Slot g_slots[kRing];
+struct ListState { int slot = -1; };
+std::map<void*, ListState> g_lists;
+int g_nextSlot = 0;
+std::map<unsigned long long, std::pair<double, int>> g_acc;   // per kernel: total ms, dispatch count
+double g_frameMs = 0; int g_frames = 0;
+bool g_timingInit = false, g_timingOk = false;
+
+void InitTiming(ID3D12Device* dev)
+{
+    g_timingInit = true;
+    D3D12_QUERY_HEAP_DESC qd = {}; qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP; qd.Count = kRing * kMaxDisp * 2;
+    if (FAILED(dev->CreateQueryHeap(&qd, __uuidof(ID3D12QueryHeap), (void**)&g_qheap))) return;
+    D3D12_HEAP_PROPERTIES hp = {}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {}; rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = qd.Count * 8; rd.Height = rd.DepthOrArraySize = rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    if (FAILED(dev->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, __uuidof(ID3D12Resource), (void**)&g_qread))) return;
+    D3D12_RANGE rr = {0, 0};
+    if (FAILED(g_qread->Map(0, &rr, (void**)&g_qmap))) return;
+    D3D12_COMMAND_QUEUE_DESC cq = {}; cq.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    ID3D12CommandQueue* q = nullptr;
+    if (SUCCEEDED(dev->CreateCommandQueue(&cq, __uuidof(ID3D12CommandQueue), (void**)&q))) { UINT64 f = 0; if (SUCCEEDED(q->GetTimestampFrequency(&f)) && f) g_tsFreq = (double)f; q->Release(); }
+    g_timingOk = true;
+    TraceF("x4r: GPU timing enabled, timestamp frequency %.0f Hz", g_tsFreq);
+}
+
+void ConsumeSlot(Slot& sl, int idx)   // read the timestamps of a finished frame
+{
+    if (!sl.used || !sl.resolved) return;
+    double total = 0;
+    for (int d = 0; d < sl.count; ++d)
+    {
+        UINT64 a = g_qmap[(idx * kMaxDisp + d) * 2], b = g_qmap[(idx * kMaxDisp + d) * 2 + 1];
+        double ms = b >= a ? (double)(b - a) * 1000.0 / g_tsFreq : 0;
+        auto& acc = g_acc[sl.hash[d]]; acc.first += ms; acc.second++;
+        total += ms;
+    }
+    g_frameMs += total; ++g_frames;
+    if (g_frames % 120 == 1)   // one frame in dispatch order: exposes gaps and what runs when
+        for (int d = 0; d < sl.count; ++d)
+        {
+            UINT64 a = g_qmap[(idx * kMaxDisp + d) * 2], b = g_qmap[(idx * kMaxDisp + d) * 2 + 1];
+            TraceF("x4r:   order %2d kernel %016llx %.3f ms, starts +%.3f ms", d, sl.hash[d], b >= a ? (double)(b - a) * 1000.0 / g_tsFreq : 0.0,
+                   (double)(a - g_qmap[(idx * kMaxDisp) * 2]) * 1000.0 / g_tsFreq);
+        }
+    if (g_frames % 120 == 0)
+    {
+        TraceF("x4r: GPU xess time per frame (avg of last 120): %.3f ms", g_frameMs / 120);
+        WriteStatus(g_frameMs / 120);
+        for (auto& kv : g_acc) TraceF("x4r:   kernel %016llx: %.3f ms/frame (%d dispatches/frame)", kv.first, kv.second.first / 120, kv.second.second / 120);
+        g_acc.clear(); g_frameMs = 0;
+    }
+    sl.used = false; sl.resolved = false; sl.count = 0;
+}
+
+void STDMETHODCALLTYPE h_SetPSO(ID3D12GraphicsCommandList* l, ID3D12PipelineState* p)
+{
+    { std::lock_guard<std::mutex> g(g_mx); g_curPso[l] = p; }
+    o_SetPSO(l, p);
+}
+void STDMETHODCALLTYPE h_Dispatch(ID3D12GraphicsCommandList* l, UINT x, UINT y, UINT z)
+{
+    unsigned long long h = 0;
+    int slot = -1, di = -1;
+    {
+        std::lock_guard<std::mutex> g(g_mx);
+        auto it = g_curPso.find(l);
+        if (it != g_curPso.end()) { auto j = g_psoHash.find(it->second); if (j != g_psoHash.end()) h = j->second; }
+        if (h) g_xessLists[l] = true;
+        if (h && g_timingOk)
+        {
+            ListState& ls = g_lists[l];
+            if (ls.slot < 0)
+            {
+                ls.slot = g_nextSlot; g_nextSlot = (g_nextSlot + 1) % kRing;
+                ConsumeSlot(g_slots[ls.slot], ls.slot);          // the frame that used this slot kRing lists ago is long finished
+                g_slots[ls.slot].used = true; g_slots[ls.slot].resolved = false; g_slots[ls.slot].count = 0;
+            }
+            slot = ls.slot;
+            if (g_slots[slot].count < kMaxDisp) { di = g_slots[slot].count++; g_slots[slot].hash[di] = h; }
+        }
+    }
+    std::call_once(g_splitOnce, LoadSplitZ);
+    if (h && g_dispatches++ == 0) WriteStatus(0);
+    if (h) { auto sz = g_splitZ.find(h); if (sz != g_splitZ.end()) z *= sz->second; }
+    if (h && g_dispLogs < 600) { ++g_dispLogs; TraceF("x4r: dispatch %016llx %u %u %u list %p", h, x, y, z, (void*)l); }
+    else if (!h && g_dumpOn && g_dispLogs < 600) { ++g_dispLogs; void* pso = nullptr; { std::lock_guard<std::mutex> g(g_mx); auto it = g_curPso.find(l); if (it != g_curPso.end()) pso = it->second; }
+        TraceF("x4r: dispatch NATIVE pso %p %u %u %u list %p", pso, x, y, z, (void*)l); }
+    int dumpOcc = -1;
+    if (h && g_dumpOn)
+    {
+        std::vector<Pending> done;
+        {
+            std::lock_guard<std::mutex> g(g_mx);
+            auto w = g_dumpWant.find(h);
+            if (w != g_dumpWant.end())
+            {
+                const int occ = g_dumpSeen[h]++;
+                const int last = w->second.rbegin()->first;
+                if (w->second.count(occ)) dumpOcc = occ;
+                else if (occ == last + 1) done.swap(g_pending[h]);   // the next frame: the captured dispatches have finished on the GPU
+            }
+        }
+        if (!done.empty()) { FlushDumps(done); TraceF("x4r: dump of kernel %016llx written", h); }
+    }
+    char tag[64] = {};
+    if (dumpOcc >= 0)
+    {
+        snprintf(tag, sizeof tag, "k%016llx_n%d", h, dumpOcc);
+        if (FILE* m = nullptr; fopen_s(&m, (g_dir + "\\dump\\manifest.txt").c_str(), "ab") == 0 && m) { fprintf(m, "# %s dispatch %u %u %u\n", tag, x, y, z); fclose(m); }
+        std::vector<Pending> pre; DumpBindings(l, std::string(tag) + "_pre", pre);
+        std::lock_guard<std::mutex> g(g_mx); auto& v = g_pending[h]; v.insert(v.end(), pre.begin(), pre.end());
+    }
+    static std::map<unsigned long long, bool> skip = [] { std::map<unsigned long long, bool> m; char b[4096] = {};   // debug: X4R_SKIP=<hash>,... drops those dispatches
+        if (GetEnvironmentVariableA("X4R_SKIP", b, sizeof b)) for (char* t = strtok(b, ","); t; t = strtok(nullptr, ",")) m[strtoull(t, nullptr, 16)] = true; return m; }();
+    if (h && skip.count(h)) return;
+    static const bool serialize = GetEnvironmentVariableA("X4R_SERIALIZE", nullptr, 0) > 0;   // debug: full UAV barrier before every translated dispatch
+    if (h && serialize) { D3D12_RESOURCE_BARRIER ub = {}; ub.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; l->ResourceBarrier(1, &ub); }
+    if (di >= 0) l->EndQuery(g_qheap, D3D12_QUERY_TYPE_TIMESTAMP, (slot * kMaxDisp + di) * 2);
+    o_Dispatch(l, x, y, z);
+    if (dumpOcc >= 0)
+    {
+        D3D12_RESOURCE_BARRIER ub = {}; ub.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; l->ResourceBarrier(1, &ub);
+        std::vector<Pending> post; DumpBindings(l, std::string(tag) + "_post", post);
+        std::lock_guard<std::mutex> g(g_mx); auto& v = g_pending[h]; v.insert(v.end(), post.begin(), post.end());
+    }
+    if (di >= 0) l->EndQuery(g_qheap, D3D12_QUERY_TYPE_TIMESTAMP, (slot * kMaxDisp + di) * 2 + 1);
+}
+HRESULT STDMETHODCALLTYPE h_Close(ID3D12GraphicsCommandList* l)
+{
+    if (g_timingOk)
+    {
+        int slot = -1, count = 0;
+        {
+            std::lock_guard<std::mutex> g(g_mx);
+            auto it = g_lists.find(l);
+            if (it != g_lists.end() && it->second.slot >= 0) { slot = it->second.slot; count = g_slots[slot].count; g_slots[slot].resolved = true; it->second.slot = -1; }
+        }
+        if (slot >= 0 && count > 0)
+            l->ResolveQueryData(g_qheap, D3D12_QUERY_TYPE_TIMESTAMP, slot * kMaxDisp * 2, count * 2, g_qread, (UINT64)slot * kMaxDisp * 2 * 8);
+    }
+    return o_Close(l);
+}
