+void DumpBindings(ID3D12GraphicsCommandList* l, const std::string& tag, std::vector<Pending>& out)
+{
+    std::lock_guard<std::mutex> g(g_mx);
+    const ListBind& b = g_bind[l];
+    FILE* man = nullptr; fopen_s(&man, (g_dir + "\\dump\\manifest.txt").c_str(), "ab");
+    if (man) fprintf(man, "# %s rootsig %016llx\n", tag.c_str(), b.rs);
+    auto ps = g_rsParams.find(b.rs);
+    if (ps == g_rsParams.end()) { if (man) { fprintf(man, "# root signature not parsed\n"); fclose(man); } return; }
+    for (UINT pi = 0; pi < ps->second.size(); ++pi)
+    {
+        const ParamRec& p = ps->second[pi];
+        if (p.type == D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS)
+        {
+            auto c = b.consts.find(pi);
+            if (man) { fprintf(man, "%s_rootconst_b%u n %u:", tag.c_str(), p.reg, p.n); if (c != b.consts.end()) for (UINT v : c->second) fprintf(man, " %08x", v); fprintf(man, "\n"); }
+            continue;
+        }
+        if (p.type != D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+        {
+            auto v = b.rootVa.find(pi);
+            if (v == b.rootVa.end()) continue;
+            auto [r, off] = BufferAt(v->second);
+            const char k = p.type == D3D12_ROOT_PARAMETER_TYPE_CBV ? 'b' : p.type == D3D12_ROOT_PARAMETER_TYPE_SRV ? 't' : 'u';
+            if (r) CopyOut(l, r, k == 'u' ? D3D12_RESOURCE_STATE_UNORDERED_ACCESS : k == 'b' ? D3D12_RESOURCE_STATE_VERTEX_AND_CONSTANT_BUFFER : D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                           tag + "_root" + k + std::to_string(p.reg), man, out, off, 0);
+            continue;
+        }
+        auto t = b.tables.find(pi);
+        if (t == b.tables.end()) continue;
+        UINT run = 0;
+        for (const RangeRec& rg : p.ranges)
+        {
+            const UINT start = rg.offset == D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND ? run : rg.offset;
+            const UINT count = rg.count == UINT_MAX ? 1 : rg.count;
+            for (UINT i = 0; i < count; ++i)
+            {
+                const UINT64 gh = t->second + (UINT64)(start + i) * g_inc;
+                const char k = rg.type == D3D12_DESCRIPTOR_RANGE_TYPE_SRV ? 't' : rg.type == D3D12_DESCRIPTOR_RANGE_TYPE_UAV ? 'u' : rg.type == D3D12_DESCRIPTOR_RANGE_TYPE_CBV ? 'b' : 's';
+                const std::string name = tag + "_" + k + std::to_string(rg.base + i);
+                const ViewRec* v = nullptr;
+                for (const HeapRec& h : g_heaps)
+                    if (gh >= h.gpu && gh < h.gpu + (UINT64)h.n * g_inc) { auto it = g_views.find(h.cpu + (SIZE_T)(gh - h.gpu)); if (it != g_views.end()) v = &it->second; break; }
+                if (!v) { if (man && k != 's') fprintf(man, "%s missing\n", name.c_str()); continue; }
+                if (v->kind == 3) { auto [r, off] = BufferAt(v->va); if (r) CopyOut(l, r, D3D12_RESOURCE_STATE_VERTEX_AND_CONSTANT_BUFFER, name, man, out, off, v->size); else if (man) fprintf(man, "%s cbv not found\n", name.c_str()); }
+                else if (v->res) CopyOut(l, v->res, v->kind == 2 ? D3D12_RESOURCE_STATE_UNORDERED_ACCESS : D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, name, man, out);
+                if (man && v->kind != 3) fprintf(man, "%s view fmt %d\n", name.c_str(), (int)v->fmt);
+            }
+            run = start + count;
+        }
+    }
+    if (man) fclose(man);
+}
+
+void FlushDumps(std::vector<Pending>& ps)
+{
+    for (Pending& p : ps)
+    {
+        void* m = nullptr; D3D12_RANGE r = {0, (SIZE_T)p.bytes};
+        if (SUCCEEDED(p.rb->Map(0, &r, &m)) && m)
+        {
+            if (FILE* f = nullptr; fopen_s(&f, (g_dir + "\\dump\\" + p.name + ".bin").c_str(), "wb") == 0 && f) { fwrite(m, 1, (size_t)p.bytes, f); fclose(f); }
+            D3D12_RANGE e = {0, 0}; p.rb->Unmap(0, &e);
+        }
+        p.rb->Release();
+    }
+    ps.clear();
+}
