+// SPDX-License-Identifier: GPL-3.0-only
+// x4r HIP backend (native Windows, "d3dhip"): XeSS' CM kernels run as AMDGPU code objects on AMD's HIP runtime, inside the game's
+// D3D12 frame. #included inside X4r.cpp's anonymous namespace (uses g_views, g_heaps, g_rsParams, g_bind, g_bufs, BufferAt, TraceF).
+//
+//  * Memory: the heaps libxess creates get D3D12_HEAP_FLAG_SHARED and are imported into HIP once, so its placed buffers are the
+//    same memory on both sides (its weight uploads and constant copies land where the kernels read them). libxess' own textures
+//    are only ever touched by its kernels: they live in HIP as pitch-linear shadows. The game's textures (colour, motion, depth,
+//    output...) go through shared linear buffers: a small D3D12 shader packs the inputs before HIP runs and unpacks the outputs
+//    after it (as m4r's dx_interop).
+//  * Dispatch: a dispatch of a kernel with a code object is not recorded into D3D12. Its bindings are resolved into the kernel
+//    argument (X4rArgs, see x4r_hip.h) and appended to the list's batch; copies between dispatches join the batch at their place.
+//    The game's list is split at the first such dispatch (d4r_d3d12_split.h): between the parts the queue signals a shared
+//    fence, HIP waits for it, runs the batch and signals back, and the queue waits for that before the second part.
+
+namespace xh
+{
+using namespace hipdyn;
+const Api* H = nullptr;
+std::recursive_mutex g_hmx;   // resources, records, ring, kernels (recording side)
+std::mutex g_bmx;              // g_batchOf and the second lists: also taken inside d4r_split's lock (Done), so never held around begin()
+std::mutex g_tmx;              // timing
+bool g_ok = false;
+std::string g_why;
+hipStream_t g_stream = nullptr;
+ID3D12Device* g_hdev = nullptr;
+ID3D12Fence* g_front = nullptr;            // shared: queue <-> HIP
+hipExternalSemaphore_t g_frontSem = nullptr;
+uint64_t g_frontValue = 0;
+ID3D12Fence* g_splitFence = nullptr;       // d4r_split's own wait (signalled from the CPU after the hand-off is queued)
+uint64_t g_splitValue = 0;
+ID3D12Fence* g_retire = nullptr;           // signalled behind each second part: its list can be reused
+uint64_t g_retireValue = 0;
+uintptr_t g_xessLo = 0, g_xessHi = 0;      // libxess.dll's image
+bool g_wmma = false;                       // <dir>\hip\flavour.txt says "wmma" (tools/build_hip.py --wmma)
+
+bool FromXess(void* ret)
+{
+    if (!g_xessHi)
+    {
+        HMODULE m = GetModuleHandleA("libxess.dll");
+        MODULEINFO mi = {};
+        if (!m || !GetModuleInformation(GetCurrentProcess(), m, &mi, sizeof mi)) return false;
+        g_xessLo = (uintptr_t)mi.lpBaseOfDll; g_xessHi = g_xessLo + mi.SizeOfImage;
+    }
+    return (uintptr_t)ret >= g_xessLo && (uintptr_t)ret < g_xessHi;
+}
+
+bool Ck(hipError_t e, const char* what)
+{
+    if (!e) return true;
+    TraceF("x4r: HIP %s: %s", what, H ? H->err(e) : "?");
+    return false;
+}
+
+// ---- formats -----------------------------------------------------------------------------------------------------------------
+struct Fmt { uint32_t bytes; hipChannelFormatDesc d; hipTextureReadMode rm; };
+DXGI_FORMAT Typed(DXGI_FORMAT f)
+{
+    switch (f)
+    {
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS: return DXGI_FORMAT_R16G16B16A16_FLOAT;
+    case DXGI_FORMAT_R32G32B32A32_TYPELESS: return DXGI_FORMAT_R32G32B32A32_FLOAT;
+    case DXGI_FORMAT_R16G16_TYPELESS: return DXGI_FORMAT_R16G16_FLOAT;
+    case DXGI_FORMAT_R32G32_TYPELESS: return DXGI_FORMAT_R32G32_FLOAT;
+    case DXGI_FORMAT_R32_TYPELESS: case DXGI_FORMAT_D32_FLOAT: return DXGI_FORMAT_R32_FLOAT;
+    case DXGI_FORMAT_R16_TYPELESS: case DXGI_FORMAT_D16_UNORM: return DXGI_FORMAT_R16_UNORM;
+    case DXGI_FORMAT_R8_TYPELESS: return DXGI_FORMAT_R8_UNORM;
+    case DXGI_FORMAT_R8G8_TYPELESS: return DXGI_FORMAT_R8G8_UNORM;
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS: return DXGI_FORMAT_R8G8B8A8_UNORM;
+    case DXGI_FORMAT_R24G8_TYPELESS: case DXGI_FORMAT_D24_UNORM_S8_UINT: return DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
+    case DXGI_FORMAT_R32G8X24_TYPELESS: case DXGI_FORMAT_D32_FLOAT_S8X24_UINT: return DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS;
+    case DXGI_FORMAT_R10G10B10A2_TYPELESS: return DXGI_FORMAT_R10G10B10A2_UNORM;
+    case DXGI_FORMAT_B8G8R8A8_TYPELESS: return DXGI_FORMAT_B8G8R8A8_UNORM;
+    default: return f;
+    }
+}
+// the formats HIP can describe natively (libxess' own textures and the shared buffers' layouts)
+bool FmtOf(DXGI_FORMAT f, Fmt& o)
+{
+    const auto F = hipChannelFormatKindFloat, U = hipChannelFormatKindUnsigned;
+    const auto E = hipReadModeElementType, N = hipReadModeNormalizedFloat;
+    switch (Typed(f))
+    {
+    case DXGI_FORMAT_R16G16B16A16_FLOAT: o = {8, {16, 16, 16, 16, F}, E}; return true;
+    case DXGI_FORMAT_R32G32B32A32_FLOAT: o = {16, {32, 32, 32, 32, F}, E}; return true;
+    case DXGI_FORMAT_R16G16_FLOAT: o = {4, {16, 16, 0, 0, F}, E}; return true;
+    case DXGI_FORMAT_R32G32_FLOAT: o = {8, {32, 32, 0, 0, F}, E}; return true;
+    case DXGI_FORMAT_R32_FLOAT: o = {4, {32, 0, 0, 0, F}, E}; return true;
+    case DXGI_FORMAT_R16_FLOAT: o = {2, {16, 0, 0, 0, F}, E}; return true;
+    case DXGI_FORMAT_R16_UNORM: o = {2, {16, 0, 0, 0, U}, N}; return true;
+    case DXGI_FORMAT_R8_UNORM: o = {1, {8, 0, 0, 0, U}, N}; return true;
+    case DXGI_FORMAT_R8G8_UNORM: o = {2, {8, 8, 0, 0, U}, N}; return true;
+    case DXGI_FORMAT_R8G8B8A8_UNORM: o = {4, {8, 8, 8, 8, U}, N}; return true;
+    case DXGI_FORMAT_R16G16B16A16_UNORM: o = {8, {16, 16, 16, 16, U}, N}; return true;
+    case DXGI_FORMAT_R16G16_UNORM: o = {4, {16, 16, 0, 0, U}, N}; return true;
+    default: return false;
+    }
+}
+// shared-buffer layout for a game texture viewed with format f (the pack/unpack shaders' `layout`)
+enum Layout : uint32_t { L_RGBA16F = 0, L_R32F = 1, L_RG16F = 2, L_RGBA32F = 3 };
+Layout LayoutOf(DXGI_FORMAT f)
+{
+    switch (Typed(f))
+    {
+    case DXGI_FORMAT_R32G32B32A32_FLOAT: case DXGI_FORMAT_R32G32_FLOAT: case DXGI_FORMAT_R32G32B32_FLOAT: return L_RGBA32F;
+    case DXGI_FORMAT_R16G16_FLOAT: case DXGI_FORMAT_R16G16_UNORM: case DXGI_FORMAT_R16G16_SNORM: case DXGI_FORMAT_R8G8_UNORM:
+    case DXGI_FORMAT_R8G8_SNORM: return L_RG16F;
+    case DXGI_FORMAT_R32_FLOAT: case DXGI_FORMAT_R16_FLOAT: case DXGI_FORMAT_R16_UNORM: case DXGI_FORMAT_R8_UNORM:
+    case DXGI_FORMAT_R24_UNORM_X8_TYPELESS: case DXGI_FORMAT_R32_FLOAT_X8X24_TYPELESS: return L_R32F;
+    default: return L_RGBA16F;
+    }
+}
+DXGI_FORMAT LayoutFormat(Layout l)
+{
+    return l == L_RGBA16F ? DXGI_FORMAT_R16G16B16A16_FLOAT : l == L_R32F ? DXGI_FORMAT_R32_FLOAT : l == L_RG16F ? DXGI_FORMAT_R16G16_FLOAT : DXGI_FORMAT_R32G32B32A32_FLOAT;
+}
+uint32_t LayoutBytes(Layout l) { return l == L_RGBA16F ? 8 : l == L_RGBA32F ? 16 : 4; }
+
+// ---- device-side records (texture: 64 bytes, sampled then storage descriptor; sampler: 16 bytes) ------------------------------
+uint8_t* g_arena = nullptr; size_t g_arenaHead = 0; constexpr size_t kArena = 4u << 20;
+uint64_t ArenaPut(const void* p, size_t n)
+{
+    n = (n + 63) & ~size_t(63);
+    if (!g_arena || g_arenaHead + n > kArena)
+    {
+        if (!Ck(H->hipMalloc((void**)&g_arena, kArena), "record arena")) return 0;
+        g_arenaHead = 0;
+    }
+    uint8_t* d = g_arena + g_arenaHead; g_arenaHead += n;
+    if (!Ck(H->hipMemcpy(d, p, n, hipMemcpyHostToDevice), "record upload")) return 0;
+    return (uint64_t)d;
+}
+// image descriptor HIP builds for pitch-linear memory (as hipvk's makeSrd)
+bool Srd(void* dev, uint32_t pitch, uint32_t w, uint32_t h, const Fmt& f, uint32_t out[8])
+{
+    hipResourceDesc r{}; r.resType = hipResourceTypePitch2D;
+    r.res.pitch2D.devPtr = dev; r.res.pitch2D.desc = f.d; r.res.pitch2D.width = w; r.res.pitch2D.height = h; r.res.pitch2D.pitchInBytes = pitch;
+    hipTextureDesc td{}; td.addressMode[0] = td.addressMode[1] = td.addressMode[2] = hipAddressModeClamp;
+    td.filterMode = hipFilterModePoint; td.readMode = f.rm;
+    hipTextureObject_t t = nullptr;
+    if (!Ck(H->hipCreateTextureObject(&t, &r, &td, nullptr), "hipCreateTextureObject")) return false;
+    const bool ok = Ck(H->hipMemcpy(out, (void*)t, 32, hipMemcpyDeviceToHost), "texture descriptor");
+    H->hipDestroyTextureObject(t);
+    return ok;
+}
+uint64_t TexRecord(void* dev, uint32_t pitch, uint32_t w, uint32_t h, const Fmt& f)
+{
+    uint32_t rec[16];
+    if (!Srd(dev, pitch, w, h, f, rec)) return 0;
+    memcpy(rec + 8, rec, 32);
+    return ArenaPut(rec, 64);
+}
+// D3D12 static sampler -> descriptor (dwords 12-15 of a texture object over a 1x1 image, as hipvk's CreateSampler)
+std::map<uint64_t, uint64_t> g_samplers;
+uint64_t SamplerRecord(UINT filter, UINT au, UINT av, UINT aw)
+{
+    const uint64_t key = (uint64_t)filter | ((uint64_t)au << 32) | ((uint64_t)av << 40) | ((uint64_t)aw << 48);
+    auto it = g_samplers.find(key);
+    if (it != g_samplers.end()) return it->second;
+    static void* backing = nullptr;
+    if (!backing && !Ck(H->hipMalloc(&backing, 256), "sampler backing")) return 0;
+    auto mode = [](UINT m) { return m == D3D12_TEXTURE_ADDRESS_MODE_WRAP ? hipAddressModeWrap : m == D3D12_TEXTURE_ADDRESS_MODE_MIRROR ? hipAddressModeMirror
+                                    : m == D3D12_TEXTURE_ADDRESS_MODE_BORDER ? hipAddressModeBorder : hipAddressModeClamp; };
+    hipResourceDesc r{}; r.resType = hipResourceTypePitch2D;
+    r.res.pitch2D.devPtr = backing; r.res.pitch2D.desc = {32, 0, 0, 0, hipChannelFormatKindFloat};
+    r.res.pitch2D.width = 1; r.res.pitch2D.height = 1; r.res.pitch2D.pitchInBytes = 256;
+    hipTextureDesc td{};
+    td.addressMode[0] = mode(au); td.addressMode[1] = mode(av); td.addressMode[2] = mode(aw);
+    td.filterMode = (filter & 0x14) ? hipFilterModeLinear : hipFilterModePoint;   // D3D12_FILTER: min 0x10, mag 0x4
+    td.mipmapFilterMode = (filter & 0x1) ? hipFilterModeLinear : hipFilterModePoint;
+    td.readMode = hipReadModeElementType; td.normalizedCoords = 1; td.maxMipmapLevelClamp = 1000.0f;
+    hipTextureObject_t t = nullptr;
+    uint32_t w[16] = {};
+    if (!Ck(H->hipCreateTextureObject(&t, &r, &td, nullptr), "sampler")) return 0;
+    const bool ok = Ck(H->hipMemcpy(w, (void*)t, 64, hipMemcpyDeviceToHost), "sampler descriptor");
+    H->hipDestroyTextureObject(t);
+    const uint64_t a = ok ? ArenaPut(w + 12, 16) : 0;
+    g_samplers[key] = a;
+    return a;
+}
+uint64_t g_dummyRec = 0;   // unbound slots: a 1x1 image record (buffers through it have size 0: every access is out of range)
+
+// ---- pinned ring: root constants and CPU-side (upload heap) data snapshotted at record time ------------------------------------
+uint8_t* g_ring = nullptr; size_t g_ringHead = 0; constexpr size_t kRing = 32u << 20;
+uint8_t* RingPut(const void* p, size_t n)
+{
+    const size_t a = (n + 255) & ~size_t(255);
+    if (a > kRing / 2) return nullptr;
+    if (g_ringHead + a > kRing) { H->hipStreamSynchronize(g_stream); g_ringHead = 0; }   // every earlier batch has consumed its data
+    uint8_t* d = g_ring + g_ringHead; g_ringHead += a;
+    memcpy(d, p, n);
+    return d;
+}
+
+// ---- resources ----------------------------------------------------------------------------------------------------------------
+struct HeapInfo { UINT64 size = 0; bool shared = false, tried = false; uint8_t* dev = nullptr; };
+std::map<ID3D12Heap*, HeapInfo> g_rheaps;
+struct ResInfo
+{
+    bool xess = false;
+    D3D12_RESOURCE_DESC desc = {};
+    D3D12_HEAP_TYPE heapType = D3D12_HEAP_TYPE_DEFAULT;
+    ID3D12Heap* heap = nullptr; UINT64 heapOff = 0;
+    bool shared = false, tried = false;
+    uint8_t* dev = nullptr;              // buffer: device address (imported); libxess texture: its shadow; game texture: the shared buffer
+    void* cpu = nullptr;                 // upload / readback buffer: mapped
+    uint32_t pitch = 0;
+    ID3D12Resource* staging = nullptr;   // game texture: the shared linear buffer
+    Layout layout = L_RGBA16F;
+    std::map<int, uint64_t> recs;        // view format -> texture record
+};
+std::map<ID3D12Resource*, ResInfo> g_res;
+
+void NoteResource(ID3D12Resource* r, const D3D12_RESOURCE_DESC* d, D3D12_HEAP_TYPE type, ID3D12Heap* heap, UINT64 off, bool xess, bool shared)
+{
+    std::lock_guard<std::recursive_mutex> l(g_hmx);
+    ResInfo ri; ri.xess = xess; ri.desc = *d; ri.heapType = type; ri.heap = heap; ri.heapOff = off; ri.shared = shared;
+    g_res[r] = ri;   // a new resource at a freed one's address replaces its record
+}
+void NoteHeap(ID3D12Heap* h, UINT64 size, bool shared)
+{
+    std::lock_guard<std::recursive_mutex> l(g_hmx);
+    HeapInfo hi; hi.size = size; hi.shared = shared; g_rheaps[h] = hi;
+}
+
+bool Import(HANDLE nt, UINT64 bytes, bool resource, uint8_t** out)
+{
+    hipExternalMemoryHandleDesc d{};
+    d.type = resource ? hipExternalMemoryHandleTypeD3D12Resource : hipExternalMemoryHandleTypeD3D12Heap;
+    d.handle.win32.handle = nt; d.size = bytes; d.flags = resource ? 1 : 0;   // hipExternalMemoryDedicated
+    hipExternalMemory_t m = nullptr;
+    if (!Ck(H->hipImportExternalMemory(&m, &d), "hipImportExternalMemory")) return false;
+    hipExternalMemoryBufferDesc b{}; b.size = bytes;
+    void* p = nullptr;
+    if (!Ck(H->hipExternalMemoryGetMappedBuffer(&p, m, &b), "hipExternalMemoryGetMappedBuffer")) { H->hipDestroyExternalMemory(m); return false; }
+    *out = (uint8_t*)p;
+    return true;
+}
+
+// device address of a buffer's first byte (null: not importable; upload / readback buffers are reached through ri.cpu)
+uint8_t* BufferDev(ID3D12Resource* r, ResInfo& ri)
+{
+    if (ri.dev || ri.tried) return ri.dev;
+    ri.tried = true;
+    if (ri.heapType == D3D12_HEAP_TYPE_UPLOAD || ri.heapType == D3D12_HEAP_TYPE_READBACK)
+    {
+        D3D12_RANGE none = {0, 0};
+        if (FAILED(r->Map(0, ri.heapType == D3D12_HEAP_TYPE_UPLOAD ? &none : nullptr, &ri.cpu))) ri.cpu = nullptr;
+        return nullptr;
+    }
+    if (ri.heap)
+    {
+        auto it = g_rheaps.find(ri.heap);
+        if (it == g_rheaps.end() || !it->second.shared) { TraceF("x4r: HIP: buffer %p is in a heap HIP cannot import", (void*)r); return nullptr; }
+        HeapInfo& hi = it->second;
+        if (!hi.dev && !hi.tried)
+        {
+            hi.tried = true;
+            HANDLE nt = nullptr;
+            if (SUCCEEDED(g_hdev->CreateSharedHandle(ri.heap, nullptr, GENERIC_ALL, nullptr, &nt)))
+            {
+                if (Import(nt, hi.size, false, &hi.dev)) TraceF("x4r: HIP: heap %p (%llu bytes) imported at %p", (void*)ri.heap, (unsigned long long)hi.size, hi.dev);
+                CloseHandle(nt);
+            }
+            else TraceF("x4r: HIP: no shared handle for heap %p", (void*)ri.heap);
+        }
+        if (hi.dev) ri.dev = hi.dev + ri.heapOff;
+        return ri.dev;
+    }
+    if (!ri.shared) { TraceF("x4r: HIP: buffer %p is not shared", (void*)r); return nullptr; }
+    HANDLE nt = nullptr;
+    const UINT64 bytes = g_hdev->GetResourceAllocationInfo(0, 1, &ri.desc).SizeInBytes;
+    if (SUCCEEDED(g_hdev->CreateSharedHandle(r, nullptr, GENERIC_ALL, nullptr, &nt))) { Import(nt, bytes, true, &ri.dev); CloseHandle(nt); }
+    return ri.dev;
+}
+
+// ---- the game-texture interop shaders (m4r's dx_interop) ----------------------------------------------------------------------
+static const char kInterop[] = R"(
+cbuffer C : register(b0) { uint w, h, pitch, layout; };
+Texture2D<float4> src : register(t0);
+RWByteAddressBuffer dst : register(u0);
+ByteAddressBuffer srcBuf : register(t1);
+RWTexture2D<float4> dstTex : register(u1);
+uint pack2(float a, float b) { return f32tof16(a) | (f32tof16(b) << 16); }
+[numthreads(8, 8, 1)] void pack(uint3 id : SV_DispatchThreadID) {
+    if (id.x >= w || id.y >= h) return;
+    float4 v = src.Load(int3(id.xy, 0));
+    uint off = id.y * pitch;
+    if (layout == 0) dst.Store2(off + id.x * 8, uint2(pack2(v.x, v.y), pack2(v.z, v.w)));
+    else if (layout == 1) dst.Store(off + id.x * 4, asuint(v.x));
+    else if (layout == 2) dst.Store(off + id.x * 4, pack2(v.x, v.y));
+    else dst.Store4(off + id.x * 16, asuint(v));
+}
+[numthreads(8, 8, 1)] void unpack(uint3 id : SV_DispatchThreadID) {
+    if (id.x >= w || id.y >= h) return;
+    uint off = id.y * pitch;
+    float4 v;
+    if (layout == 0) { uint2 d = srcBuf.Load2(off + id.x * 8); v = float4(f16tof32(d.x), f16tof32(d.x >> 16), f16tof32(d.y), f16tof32(d.y >> 16)); }
+    else if (layout == 1) v = float4(asfloat(srcBuf.Load(off + id.x * 4)), 0, 0, 1);
+    else if (layout == 2) { uint d = srcBuf.Load(off + id.x * 4); v = float4(f16tof32(d), f16tof32(d >> 16), 0, 1); }
+    else v = asfloat(srcBuf.Load4(off + id.x * 16));
+    dstTex[id.xy] = v;
+}
+)";
+ID3D12RootSignature* g_ioRoot = nullptr;
+ID3D12PipelineState *g_ioPack = nullptr, *g_ioUnpack = nullptr;
+ID3D12DescriptorHeap* g_ioHeap = nullptr;
+UINT g_ioNext = 0; constexpr UINT kIoHeap = 4096;
+
+bool InitInterop(ID3D12Device* dev)
+{
+    HMODULE dc = LoadLibraryA("d3dcompiler_47.dll");
+    auto compile = dc ? (pD3DCompile)GetProcAddress(dc, "D3DCompile") : nullptr;
+    using PFN_Ser = HRESULT(WINAPI*)(const D3D12_ROOT_SIGNATURE_DESC*, D3D_ROOT_SIGNATURE_VERSION, ID3DBlob**, ID3DBlob**);
+    auto ser = (PFN_Ser)GetProcAddress(GetModuleHandleA("d3d12.dll"), "D3D12SerializeRootSignature");
+    if (!compile || !ser) { g_why = "d3dcompiler_47.dll or D3D12SerializeRootSignature missing"; return false; }
+    ID3DBlob *pk = nullptr, *up = nullptr, *err = nullptr, *sig = nullptr;
+    if (FAILED(compile(kInterop, sizeof kInterop - 1, "x4r_interop", nullptr, nullptr, "pack", "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &pk, &err)) ||
+        FAILED(compile(kInterop, sizeof kInterop - 1, "x4r_interop", nullptr, nullptr, "unpack", "cs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &up, &err)))
+    { g_why = "interop shaders: " + (err ? std::string((const char*)err->GetBufferPointer(), err->GetBufferSize()) : std::string("?")); return false; }
+    D3D12_DESCRIPTOR_RANGE srv{D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0};
+    D3D12_DESCRIPTOR_RANGE uav{D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 1, 1, 0, 0};
+    D3D12_ROOT_PARAMETER p[5] = {};
+    p[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS; p[0].Constants = {0, 0, 4};
+    p[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[1].DescriptorTable = {1, &srv};
+    p[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE; p[2].DescriptorTable = {1, &uav};
+    p[3].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV; p[3].Descriptor = {0, 0};
+    p[4].ParameterType = D3D12_ROOT_PARAMETER_TYPE_SRV; p[4].Descriptor = {1, 0};
+    D3D12_ROOT_SIGNATURE_DESC rd{5, p, 0, nullptr, D3D12_ROOT_SIGNATURE_FLAG_NONE};
+    if (FAILED(ser(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err)) ||
+        FAILED(o_CreateRootSignature(dev, 0, sig->GetBufferPointer(), sig->GetBufferSize(), __uuidof(ID3D12RootSignature), (void**)&g_ioRoot)))
+    { g_why = "interop root signature"; return false; }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pd{};
+    pd.pRootSignature = g_ioRoot;
+    pd.CS = {pk->GetBufferPointer(), pk->GetBufferSize()};
+    if (FAILED(dev->CreateComputePipelineState(&pd, __uuidof(ID3D12PipelineState), (void**)&g_ioPack))) { g_why = "pack pipeline"; return false; }
+    pd.CS = {up->GetBufferPointer(), up->GetBufferSize()};
+    if (FAILED(dev->CreateComputePipelineState(&pd, __uuidof(ID3D12PipelineState), (void**)&g_ioUnpack))) { g_why = "unpack pipeline"; return false; }
+    D3D12_DESCRIPTOR_HEAP_DESC hd{D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, kIoHeap, D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE, 0};
+    if (FAILED(dev->CreateDescriptorHeap(&hd, __uuidof(ID3D12DescriptorHeap), (void**)&g_ioHeap))) { g_why = "interop descriptor heap"; return false; }
+    pk->Release(); up->Release(); sig->Release();
+    return true;
+}
+
+// the shared linear buffer of a game texture (recreated when the texture's size changes); false: not usable
+bool GameStaging(ID3D12Resource* r, ResInfo& ri, DXGI_FORMAT viewFmt)
+{
+    if (ri.staging) return ri.dev != nullptr;
+    const D3D12_RESOURCE_DESC td = r->GetDesc();
+    ri.desc = td;
+    ri.layout = LayoutOf(viewFmt ? viewFmt : td.Format);
+    ri.pitch = ((uint32_t)td.Width * LayoutBytes(ri.layout) + 255) & ~255u;
+    D3D12_RESOURCE_DESC bd{};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)ri.pitch * td.Height; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR; bd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    D3D12_HEAP_PROPERTIES hp{D3D12_HEAP_TYPE_DEFAULT};
+    if (FAILED(o_CreateCommitted(g_hdev, &hp, D3D12_HEAP_FLAG_SHARED, &bd, D3D12_RESOURCE_STATE_COMMON, nullptr, __uuidof(ID3D12Resource), (void**)&ri.staging)))
+    { TraceF("x4r: HIP: no shared buffer for game texture %p", (void*)r); return false; }
+    HANDLE nt = nullptr;
+    const UINT64 bytes = g_hdev->GetResourceAllocationInfo(0, 1, &bd).SizeInBytes;
+    if (SUCCEEDED(g_hdev->CreateSharedHandle(ri.staging, nullptr, GENERIC_ALL, nullptr, &nt))) { Import(nt, bytes, true, &ri.dev); CloseHandle(nt); }
+    TraceF("x4r: HIP: game texture %p %llux%u fmt %d -> shared buffer layout %u pitch %u (%s)", (void*)r, (unsigned long long)td.Width, td.Height,
+           (int)td.Format, (unsigned)ri.layout, ri.pitch, ri.dev ? "imported" : "import FAILED");
+    return ri.dev != nullptr;
+}
+
+D3D12_CPU_DESCRIPTOR_HANDLE IoCpu(UINT i) { auto h = g_ioHeap->GetCPUDescriptorHandleForHeapStart(); h.ptr += (SIZE_T)i * g_inc; return h; }
+D3D12_GPU_DESCRIPTOR_HANDLE IoGpu(UINT i) { auto h = g_ioHeap->GetGPUDescriptorHandleForHeapStart(); h.ptr += (UINT64)i * g_inc; return h; }
+
+// records the conversion between a game texture and its shared buffer into `l` (bypassing the shim's own tracking hooks)
+void RecordInterop(ID3D12GraphicsCommandList* l, ID3D12Resource* tex, ResInfo& ri, DXGI_FORMAT viewFmt, bool pack)
+{
+    l->SetDescriptorHeaps(1, &g_ioHeap);
+    o_SetRS(l, g_ioRoot);
+    const UINT slot = g_ioNext++ % kIoHeap;   // reused kIoHeap views later: many frames on
+    if (pack)
+    {
+        D3D12_SHADER_RESOURCE_VIEW_DESC sd{};
+        sd.Format = Typed(viewFmt ? viewFmt : ri.desc.Format); sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; sd.Texture2D.MipLevels = 1;
+        o_CreateSRV(g_hdev, tex, &sd, IoCpu(slot));
+        o_SetTable(l, 1, IoGpu(slot));
+        o_SetRootUav(l, 3, ri.staging->GetGPUVirtualAddress());
+    }
+    else
+    {
+        D3D12_UNORDERED_ACCESS_VIEW_DESC ud{};
+        ud.Format = Typed(viewFmt ? viewFmt : ri.desc.Format); ud.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        o_CreateUAV(g_hdev, tex, nullptr, &ud, IoCpu(slot));
+        o_SetTable(l, 2, IoGpu(slot));
+        o_SetRootSrv(l, 4, ri.staging->GetGPUVirtualAddress());
+    }
+    const uint32_t c[4] = {(uint32_t)ri.desc.Width, ri.desc.Height, ri.pitch, (uint32_t)ri.layout};
+    o_SetConsts(l, 0, 4, c, 0);
+    o_SetPSO(l, pack ? g_ioPack : g_ioUnpack);
+    o_Dispatch(l, ((UINT)ri.desc.Width + 7) / 8, (ri.desc.Height + 7) / 8, 1);
+}
+
+// texture record for a view of `r` with format f: a libxess texture's shadow, else the game texture's shared buffer
+uint64_t TextureSlot(ID3D12Resource* r, DXGI_FORMAT f)
+{
+    auto it = g_res.find(r);
+    if (it == g_res.end()) it = g_res.emplace(r, ResInfo{}).first;   // created before the hooks: the game's
+    ResInfo& ri = it->second;
+    auto rec = ri.recs.find((int)f);
+    if (rec != ri.recs.end()) return rec->second;
+    uint64_t a = 0;
+    if (ri.xess)
+    {
+        Fmt res, view;
+        if (!FmtOf(ri.desc.Format, res) || !FmtOf(f ? f : ri.desc.Format, view) || res.bytes != view.bytes)
+        { TraceF("x4r: HIP: libxess texture %p: format %d / view %d not supported", (void*)r, (int)ri.desc.Format, (int)f); ri.recs[(int)f] = 0; return 0; }
+        if (!ri.dev)
+        {
+            ri.pitch = ((uint32_t)ri.desc.Width * res.bytes + 255) & ~255u;
+            const size_t bytes = (size_t)ri.pitch * ri.desc.Height;
+            if (!Ck(H->hipMalloc((void**)&ri.dev, bytes), "texture shadow")) { ri.dev = nullptr; return 0; }
+            H->hipMemsetAsync(ri.dev, 0, bytes, g_stream);
+            TraceF("x4r: HIP: libxess texture %p %llux%u fmt %d -> shadow %p pitch %u", (void*)r, (unsigned long long)ri.desc.Width, ri.desc.Height,
+                   (int)ri.desc.Format, ri.dev, ri.pitch);
+        }
+        a = TexRecord(ri.dev, ri.pitch, (uint32_t)ri.desc.Width, ri.desc.Height, view);
+    }
+    else
+    {
+        if (!GameStaging(r, ri, f)) { ri.recs[(int)f] = 0; return 0; }
+        Fmt lf; FmtOf(LayoutFormat(ri.layout), lf);
+        a = TexRecord(ri.dev, ri.pitch, (uint32_t)ri.desc.Width, ri.desc.Height, lf);
+    }
+    ri.recs[(int)f] = a;
+    return a;
+}
+
+// ---- kernels ------------------------------------------------------------------------------------------------------------------
+struct Kernel { hipModule_t mod = nullptr; hipFunction_t fn = nullptr; int block = 0; };
+std::map<unsigned long long, Kernel> g_kernels;
+Kernel* KernelFor(unsigned long long h)
+{
+    auto it = g_kernels.find(h);
+    if (it != g_kernels.end()) return it->second.fn ? &it->second : nullptr;
+    Kernel& k = g_kernels[h];
+    char path[MAX_PATH]; snprintf(path, sizeof path, "%s\\hip\\%016llx.hsaco", g_dir.c_str(), h);
+    std::vector<char> co;
+    if (FILE* f = nullptr; fopen_s(&f, path, "rb") == 0 && f)
+    {
+        fseek(f, 0, SEEK_END); long n = ftell(f); fseek(f, 0, SEEK_SET);
+        if (n > 0) { co.resize(n); if (fread(co.data(), 1, n, f) != (size_t)n) co.clear(); }
+        fclose(f);
+    }
+    if (co.empty() || !Ck(H->hipModuleLoadData(&k.mod, co.data()), path) || !Ck(H->hipModuleGetFunction(&k.fn, k.mod, "x4r_main"), "x4r_main") ||
+        !Ck(H->hipFuncGetAttribute(&k.block, 0 /* HIP_FUNC_ATTRIBUTE_MAX_THREADS_PER_BLOCK */, k.fn), "workgroup size"))
+    { k.fn = nullptr; X4rKernelFailed(h, "HIP code object unusable"); return nullptr; }
+    return &k;
+}
+
+// ---- batches ------------------------------------------------------------------------------------------------------------------
+struct X4rArgs { uint64_t slot[56]; uint32_t size[56]; };
+struct Op { int kind = 0; hipFunction_t fn = nullptr; int block = 0; UINT g[3] = {}; X4rArgs a; uint8_t *dst = nullptr; const uint8_t* src = nullptr; size_t n = 0; };   // 0 launch, 1 copy
+struct Second { ID3D12CommandAllocator* alloc = nullptr; ID3D12GraphicsCommandList* list = nullptr; D3D12_COMMAND_LIST_TYPE type; bool busy = false; uint64_t retire = 0; };
+struct Batch { ID3D12GraphicsCommandList* list = nullptr; Second* second = nullptr; std::vector<Op> ops; };
+std::vector<Second*> g_seconds;
+std::map<void*, Batch*> g_batchOf;           // the game's list and its second part -> the batch recording there
+std::map<ID3D12Resource*, std::pair<int, int>> g_gamePending;   // game textures libxess viewed since the last batch: SRV / UAV view format (0: none)
+
+// GPU time of the hand-off (D3D12 timestamps at the end of the first part and the start of the second: queue -> HIP -> queue)
+constexpr UINT kQ = 64;
+ID3D12QueryHeap* g_qh = nullptr;
+ID3D12Resource* g_qrb = nullptr;
+const UINT64* g_qmapped = nullptr;
+uint64_t g_qRetire[kQ] = {};   // slot -> retire value of its batch (0: free)
+UINT g_qNext = 0;
+double g_qFreq = 0, g_hipMs = 0; int g_hipFrames = 0;
+std::atomic<unsigned long long> g_hipLaunches{0}, g_hipBatches{0};
+
+void Collect()   // g_hmx held
+{
+    if (!g_qmapped) return;
+    const uint64_t done = g_retire->GetCompletedValue();
+    for (UINT i = 0; i < kQ; ++i)
+    {
+        if (!g_qRetire[i] || g_qRetire[i] > done) continue;
+        g_qRetire[i] = 0;
+        const UINT64 t0 = g_qmapped[2 * i], t1 = g_qmapped[2 * i + 1];
+        if (t1 < t0 || !g_qFreq) continue;
+        g_hipMs += (t1 - t0) * 1000.0 / g_qFreq;
+        if (++g_hipFrames % 120 == 0)
+        {
+            TraceF("x4r: HIP xess time per frame (queue to HIP to queue, avg of last 120): %.3f ms", g_hipMs / 120);
+            WriteStatus(g_hipMs / 120);
+            g_hipMs = 0;
+        }
+    }
+}
+
+void BeforeSecond(void* owner, ID3D12CommandQueue* q)
+{
+    Batch* b = (Batch*)owner;
+    std::lock_guard<std::mutex> l(g_tmx);
+    const uint64_t a = ++g_frontValue, z = ++g_frontValue;
+    hipExternalSemaphoreWaitParams wp{}; wp.params.fence.value = a;
+    hipExternalSemaphoreSignalParams sp{}; sp.params.fence.value = z;
+    bool ok = SUCCEEDED(q->Signal(g_front, a)) && Ck(H->hipWaitExternalSemaphoresAsync(&g_frontSem, &wp, 1, g_stream), "semaphore wait");
+    if (!g_qFreq) { UINT64 f = 0; if (SUCCEEDED(q->GetTimestampFrequency(&f))) g_qFreq = (double)f; }
+    for (size_t i = 0; i < b->ops.size(); ++i)
+    {
+        Op& o = b->ops[i];
+        if (!ok) break;
+        if (o.kind == 1) { ok = Ck(H->hipMemcpyAsync(o.dst, o.src, o.n, hipMemcpyDefault, g_stream), "batch copy"); continue; }
+        void* params[] = {&o.a};
+        static const bool prof = GetEnvironmentVariableA("X4R_HIP_PROFILE", nullptr, 0) > 0;   // debug: wall time of every launch (serialises)
+        LARGE_INTEGER f, t0, t1;
+        if (prof) { H->hipStreamSynchronize(g_stream); QueryPerformanceFrequency(&f); QueryPerformanceCounter(&t0); }
+        ok = Ck(H->hipModuleLaunchKernel(o.fn, o.g[0], o.g[1], o.g[2], (unsigned)o.block, 1, 1, 0, g_stream, params, nullptr), "launch");
+        if (prof)
+        {
+            H->hipStreamSynchronize(g_stream); QueryPerformanceCounter(&t1);
+            unsigned long long kh = 0; for (auto& [h2, k] : g_kernels) if (k.fn == o.fn) kh = h2;
+            TraceF("x4r: HIP profile kernel %016llx grid %u %u %u block %d: %.3f ms", kh, o.g[0], o.g[1], o.g[2], o.block, (t1.QuadPart - t0.QuadPart) * 1000.0 / f.QuadPart);
+        }
+        ++g_hipLaunches;
+    }
+    ok = ok && Ck(H->hipSignalExternalSemaphoresAsync(&g_frontSem, &sp, 1, g_stream), "semaphore signal");
+    static const bool sync = GetEnvironmentVariableA("X4R_HIP_SYNC", nullptr, 0) > 0;   // debug: wall-clock pieces of the hand-off
+    if (sync && ok)
+    {
+        LARGE_INTEGER f, t0, t1, t2; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&t0);
+        UINT64 v0 = g_front->GetCompletedValue();
+        while (g_front->GetCompletedValue() < a) {} QueryPerformanceCounter(&t1);
+        H->hipStreamSynchronize(g_stream); QueryPerformanceCounter(&t2);
+        auto ms = [&](LARGE_INTEGER x, LARGE_INTEGER y) { return (y.QuadPart - x.QuadPart) * 1000.0 / f.QuadPart; };
+        TraceF("x4r: HIP sync: fence %llu->%llu first part %.3f ms, HIP %.3f ms", v0, a, ms(t0, t1), ms(t1, t2));
+    }
+    if (!ok || FAILED(q->Wait(g_front, z))) { g_front->Signal(z); TraceF("x4r: HIP: hand-off failed, batch of %zu ops dropped", b->ops.size()); }
+    const unsigned long long nb = ++g_hipBatches;
+    if (nb <= 12 || nb % 120 == 0)
+    {
+        size_t launches = 0; for (const Op& o : b->ops) launches += o.kind == 0;
+        TraceF("x4r: HIP batch %llu: %zu launches, %zu copies, list %p queue %p", nb, launches, b->ops.size() - launches, (void*)b->list, (void*)q);
+    }
+}
+
+void Done(void* owner, bool executed)
+{
+    Batch* b = (Batch*)owner;
+    std::lock_guard<std::mutex> l(g_bmx);
+    g_batchOf.erase(b->list); g_batchOf.erase(b->second->list);
+    if (!executed) b->second->retire = 0;    // closed, never submitted: free at once
+    b->second->busy = false;
+    delete b;
+}
+
+Second* AcquireSecond(D3D12_COMMAND_LIST_TYPE type)
+{
+    const uint64_t done = g_retire->GetCompletedValue();
+    Second* free = nullptr;
+    {
+        std::lock_guard<std::mutex> g(g_bmx);
+        for (Second* s : g_seconds)
+            if (!s->busy && s->type == type && s->retire <= done) { s->busy = true; free = s; break; }
+    }
+    if (free)
+    {
+        if (SUCCEEDED(free->alloc->Reset()) && SUCCEEDED(free->list->Reset(free->alloc, nullptr))) return free;
+        std::lock_guard<std::mutex> g(g_bmx); free->busy = false; free->retire = ~0ull;   // unusable from now on
+    }
+    Second* s = new Second; s->type = type;
+    if (FAILED(g_hdev->CreateCommandAllocator(type, __uuidof(ID3D12CommandAllocator), (void**)&s->alloc)) ||
+        FAILED(g_hdev->CreateCommandList(0, type, s->alloc, nullptr, __uuidof(ID3D12GraphicsCommandList), (void**)&s->list)))
+    { delete s; return nullptr; }
+    s->busy = true;
+    std::lock_guard<std::mutex> g(g_bmx); g_seconds.push_back(s);
+    return s;
+}
+
+// the first HIP dispatch in `l`: pack the game's inputs, split the list, queue the outputs' unpack behind HIP
+Batch* StartBatch(ID3D12GraphicsCommandList* l)
+{
+    std::map<ID3D12Resource*, std::pair<int, int>> pend;
+    pend.swap(g_gamePending);
+    std::vector<std::pair<ID3D12Resource*, int>> unpacks;
+    bool packed = false;
+    for (auto& [r, fm] : pend)
+    {
+        auto it = g_res.find(r);
+        if (it == g_res.end()) it = g_res.emplace(r, ResInfo{}).first;
+        if (it->second.xess) continue;
+        if (!GameStaging(r, it->second, (DXGI_FORMAT)(fm.first ? fm.first : fm.second))) continue;
+        if (fm.first) { RecordInterop(l, r, it->second, (DXGI_FORMAT)fm.first, true); packed = true; }
+        if (fm.second) unpacks.push_back({r, fm.second});
+    }
+    Collect();
+    Second* s = AcquireSecond(l->GetType());
+    if (!s) { TraceF("x4r: HIP: no second list"); return nullptr; }
+    Batch* b = new Batch; b->list = l; b->second = s;
+    s->retire = ++g_retireValue;
+    UINT qs = UINT_MAX;
+    if (g_qh) for (UINT k = 0; k < kQ && qs == UINT_MAX; ++k) { const UINT c = (g_qNext + k) % kQ; if (!g_qRetire[c]) qs = c; }
+    if (qs != UINT_MAX) { g_qNext = qs + 1; l->EndQuery(g_qh, D3D12_QUERY_TYPE_TIMESTAMP, 2 * qs); }
+    if (!d4r_split::begin(l, s->list, g_splitFence, ++g_splitValue, g_retire, s->retire, &Done, b, &BeforeSecond, b))
+    { TraceF("x4r: HIP: list %p cannot be split", (void*)l); s->list->Close(); std::lock_guard<std::mutex> g(g_bmx); s->busy = false; s->retire = 0; delete b; return nullptr; }
+    {
+        std::lock_guard<std::mutex> g(g_mx);
+        g_bind[s->list] = g_bind[l];
+        g_curPso[s->list] = g_curPso[l];
+    }
+    if (qs != UINT_MAX)
+    {
+        s->list->EndQuery(g_qh, D3D12_QUERY_TYPE_TIMESTAMP, 2 * qs + 1);
+        s->list->ResolveQueryData(g_qh, D3D12_QUERY_TYPE_TIMESTAMP, 2 * qs, 2, g_qrb, (UINT64)qs * 16);
+        g_qRetire[qs] = s->retire;
+    }
+    for (auto& [r, f] : unpacks) RecordInterop(s->list, r, g_res[r], (DXGI_FORMAT)f, false);
+    if (!unpacks.empty() || packed) { D3D12_RESOURCE_BARRIER ub = {}; ub.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV; s->list->ResourceBarrier(1, &ub); }
+    std::lock_guard<std::mutex> g(g_bmx);
+    g_batchOf[l] = b; g_batchOf[s->list] = b;
+    return b;
+}
+
+// buffer range -> HIP address (upload heaps: a snapshot of the bytes as they are now)
+uint64_t BufferSlot(ID3D12Resource* r, UINT64 off, UINT64& size)
+{
+    auto it = g_res.find(r);
+    if (it == g_res.end()) { TraceF("x4r: HIP: unknown buffer %p", (void*)r); size = 0; return 0; }
+    ResInfo& ri = it->second;
+    const UINT64 total = ri.desc.Width;
+    if (off >= total) { size = 0; return 0; }
+    if (!size || off + size > total) size = total - off;
+    uint8_t* d = BufferDev(r, ri);
+    if (d) return (uint64_t)(d + off);
+    if (ri.cpu && ri.heapType == D3D12_HEAP_TYPE_UPLOAD) { uint8_t* p = RingPut((const uint8_t*)ri.cpu + off, (size_t)size); if (p) return (uint64_t)p; }
+    TraceF("x4r: HIP: buffer %p (heap type %d) has no HIP address", (void*)r, (int)ri.heapType);
+    size = 0;
+    return 0;
+}
+
+struct Bound { char k; UINT reg; ViewRec v; bool have; UINT64 va; std::vector<UINT> consts; };
+
+// resolves the list's current bindings into the kernel argument
+void Resolve(ID3D12GraphicsCommandList* l, X4rArgs& a)
+{
+    std::vector<Bound> bs;
+    std::vector<SampRec> samps;
+    {
+        std::lock_guard<std::mutex> g(g_mx);
+        const ListBind& b = g_bind[l];
+        auto ps = g_rsParams.find(b.rs);
+        if (ps == g_rsParams.end()) { TraceF("x4r: HIP: dispatch without a parsed root signature (%016llx)", b.rs); return; }
+        auto ss = g_rsSamp.find(b.rs);
+        if (ss != g_rsSamp.end()) samps = ss->second;
+        for (UINT pi = 0; pi < ps->second.size(); ++pi)
+        {
+            const ParamRec& p = ps->second[pi];
+            if (p.type == D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS)
+            {
+                Bound x{'c', p.reg, {}, true, 0, {}};
+                auto c = b.consts.find(pi); if (c != b.consts.end()) x.consts = c->second;
+                x.consts.resize(p.n);
+                bs.push_back(x);
+                continue;
+            }
+            if (p.type != D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE)
+            {
+                auto v = b.rootVa.find(pi);
+                const char k = p.type == D3D12_ROOT_PARAMETER_TYPE_CBV ? 'B' : p.type == D3D12_ROOT_PARAMETER_TYPE_SRV ? 'T' : 'U';
+                if (v != b.rootVa.end()) bs.push_back({k, p.reg, {}, true, v->second, {}});
+                continue;
+            }
+            auto t = b.tables.find(pi);
+            if (t == b.tables.end()) continue;
+            UINT run = 0;
+            for (const RangeRec& rg : p.ranges)
+            {
+                const UINT start = rg.offset == D3D12_DESCRIPTOR_RANGE_OFFSET_APPEND ? run : rg.offset;
+                const UINT count = rg.count == UINT_MAX ? 1 : rg.count;
+                const char k = rg.type == D3D12_DESCRIPTOR_RANGE_TYPE_SRV ? 't' : rg.type == D3D12_DESCRIPTOR_RANGE_TYPE_UAV ? 'u' : rg.type == D3D12_DESCRIPTOR_RANGE_TYPE_CBV ? 'b' : 's';
+                for (UINT i = 0; i < count && k != 's'; ++i)
+                {
+                    const UINT64 gh = t->second + (UINT64)(start + i) * g_inc;
+                    Bound x{k, rg.base + i, {}, false, 0, {}};
+                    for (const HeapRec& h : g_heaps)
+                        if (gh >= h.gpu && gh < h.gpu + (UINT64)h.n * g_inc) { auto it = g_views.find(h.cpu + (SIZE_T)(gh - h.gpu)); if (it != g_views.end()) { x.v = it->second; x.have = true; } break; }
+                    bs.push_back(x);
+                }
+                run = start + count;
+            }
+        }
+    }
+    for (int i = 0; i < 56; ++i) { a.slot[i] = g_dummyRec; a.size[i] = 0; }
+    for (const SampRec& s : samps) if (s.reg < 4) a.slot[52 + s.reg] = SamplerRecord(s.filter, s.u, s.v, s.w);
+    std::lock_guard<std::mutex> g(g_mx);   // BufferAt reads g_bufs
+    for (Bound& x : bs)
+    {
+        const int base = (x.k == 't' || x.k == 'T') ? 0 : (x.k == 'u' || x.k == 'U') ? 16 : 32;
+        const int slot = base + (int)x.reg;
+        if (slot >= 52 || (base < 32 && x.reg >= 16)) { TraceF("x4r: HIP: register %c%u outside the kernel argument", x.k, x.reg); continue; }
+        if (x.k == 'c')
+        {
+            uint8_t* p = RingPut(x.consts.data(), x.consts.size() * 4);
+            a.slot[slot] = (uint64_t)p; a.size[slot] = (uint32_t)(x.consts.size() * 4);
+            continue;
+        }
+        if (x.k == 'B' || x.k == 'T' || x.k == 'U')
+        {
+            auto [r, off] = BufferAt(x.va);
+            UINT64 size = x.k == 'B' ? 65536 : 0;
+            if (r) { a.slot[slot] = BufferSlot(r, off, size); a.size[slot] = (uint32_t)size; }
+            continue;
+        }
+        if (!x.have) continue;
+        const ViewRec& v = x.v;
+        if (v.kind == 3)
+        {
+            auto [r, off] = BufferAt(v.va);
+            UINT64 size = v.size;
+            if (r) { a.slot[slot] = BufferSlot(r, off, size); a.size[slot] = (uint32_t)size; }
+            continue;
+        }
+        if (!v.res) continue;
+        if (v.buffer)
+        {
+            UINT64 size = (UINT64)v.num * v.stride;
+            a.slot[slot] = BufferSlot(v.res, v.first * v.stride, size); a.size[slot] = (uint32_t)size;
+            continue;
+        }
+        if (const uint64_t rec = TextureSlot(v.res, v.fmt)) a.slot[slot] = rec;
+    }
+}
+
+bool Dispatch(ID3D12GraphicsCommandList* l, unsigned long long h, UINT x, UINT y, UINT z)
+{
+    if (!g_ok) return false;
+    std::lock_guard<std::recursive_mutex> lk(g_hmx);
+    Kernel* k = KernelFor(h);
+    if (!k) return false;
+    Batch* b = nullptr;
+    { std::lock_guard<std::mutex> g(g_bmx); auto it = g_batchOf.find(l); if (it != g_batchOf.end()) b = it->second; }
+    if (!b) b = StartBatch(l);
+    if (!b) return true;   // dropped (logged): never run the placeholder in its place
+    Op o; o.kind = 0; o.fn = k->fn; o.block = k->block; o.g[0] = x; o.g[1] = y; o.g[2] = z;
+    Resolve(l, o.a);
+    if (x && y && z) b->ops.push_back(o);
+    return true;
+}
+
+// CopyBufferRegion while `l` records a batch: it runs in the batch, at its place (the D3D12 copy would land after HIP)
+bool Copy(ID3D12GraphicsCommandList* l, ID3D12Resource* d, UINT64 doff, ID3D12Resource* s, UINT64 soff, UINT64 n)
+{
+    if (!g_ok) return false;
+    std::lock_guard<std::recursive_mutex> lk(g_hmx);
+    Batch* b = nullptr;
+    { std::lock_guard<std::mutex> g(g_bmx); auto it = g_batchOf.find(l); if (it != g_batchOf.end()) b = it->second; }
+    if (!b) return false;
+    auto di = g_res.find(d), si = g_res.find(s);
+    if (di == g_res.end() || si == g_res.end()) { TraceF("x4r: HIP: copy between unknown buffers in a batch (D3D12 copy kept)"); return false; }
+    uint8_t* dst = BufferDev(d, di->second);
+    uint8_t* sd = BufferDev(s, si->second);
+    const uint8_t* src = sd ? sd + soff : nullptr;
+    if (!sd && si->second.cpu && si->second.heapType == D3D12_HEAP_TYPE_UPLOAD) src = RingPut((const uint8_t*)si->second.cpu + soff, (size_t)n);
+    if (!dst || !src) { TraceF("x4r: HIP: copy %p -> %p not reachable from HIP (D3D12 copy kept)", (void*)s, (void*)d); return false; }
+    Op o; o.kind = 1; o.dst = dst + doff; o.src = src; o.n = (size_t)n;
+    b->ops.push_back(o);
+    return true;
+}
+
+void NoteView(ID3D12Resource* r, DXGI_FORMAT f, bool uav, void* ret)
+{
+    if (!g_ok || !r || !FromXess(ret)) return;
+    std::lock_guard<std::recursive_mutex> lk(g_hmx);
+    auto it = g_res.find(r);
+    if (it != g_res.end() && (it->second.xess || it->second.desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER)) return;
+    if (it == g_res.end() && r->GetDesc().Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) return;
+    auto& p = g_gamePending[r];
+    (uav ? p.second : p.first) = f ? (int)f : (int)r->GetDesc().Format;
+}
+
+void Init(ID3D12Device* dev)
+{
+    const char* why = nullptr;
+    g_hdev = dev;
+    if (!(H = load(&why))) { g_why = why ? why : "HIP runtime"; }
+    else if (!Ck(H->hipStreamCreateWithFlags(&g_stream, hipStreamNonBlocking), "stream")) g_why = "HIP stream";
+    else if (FAILED(dev->CreateFence(0, D3D12_FENCE_FLAG_SHARED, __uuidof(ID3D12Fence), (void**)&g_front)) ||
+             FAILED(dev->CreateFence(0, D3D12_FENCE_FLAG_NONE, __uuidof(ID3D12Fence), (void**)&g_splitFence)) ||
+             FAILED(dev->CreateFence(0, D3D12_FENCE_FLAG_NONE, __uuidof(ID3D12Fence), (void**)&g_retire))) g_why = "fences";
+    else
+    {
+        HANDLE nt = nullptr;
+        hipExternalSemaphoreHandleDesc sd{}; sd.type = hipExternalSemaphoreHandleTypeD3D12Fence;
+        if (FAILED(dev->CreateSharedHandle(g_front, nullptr, GENERIC_ALL, nullptr, &nt))) g_why = "fence handle";
+        else
+        {
+            sd.handle.win32.handle = nt;
+            if (!Ck(H->hipImportExternalSemaphore(&g_frontSem, &sd), "fence import")) g_why = "HIP fence import";
+            CloseHandle(nt);
+        }
+    }
+    const char* splitWhy = nullptr;
+    if (g_why.empty() && !InitInterop(dev)) {}
+    else if (g_why.empty() && !d4r_split::install(dev, &splitWhy)) g_why = std::string("command list split: ") + (splitWhy ? splitWhy : "?");
+    else if (g_why.empty() && !Ck(H->hipHostMalloc((void**)&g_ring, kRing, 0), "pinned ring")) g_why = "pinned ring";
+    if (g_why.empty())
+    {
+        void* px = nullptr;
+        Fmt f; FmtOf(DXGI_FORMAT_R32G32B32A32_FLOAT, f);
+        if (Ck(H->hipMalloc(&px, 256), "dummy image") && Ck(H->hipMemsetAsync(px, 0, 256, g_stream), "dummy image") && Ck(H->hipStreamSynchronize(g_stream), "dummy image")) g_dummyRec = TexRecord(px, 256, 1, 1, f);
+        if (!g_dummyRec) g_why = "dummy record";
+    }
+    if (g_why.empty())   // timing is optional
+    {
+        D3D12_QUERY_HEAP_DESC qd = {}; qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP; qd.Count = 2 * kQ;
+        D3D12_HEAP_PROPERTIES hp = {}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC rd = {}; rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = 16 * kQ; rd.Height = rd.DepthOrArraySize = rd.MipLevels = 1;
+        rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        void* m = nullptr;
+        if (SUCCEEDED(dev->CreateQueryHeap(&qd, __uuidof(ID3D12QueryHeap), (void**)&g_qh)) &&
+            SUCCEEDED(o_CreateCommitted(dev, &hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, __uuidof(ID3D12Resource), (void**)&g_qrb)) &&
+            SUCCEEDED(g_qrb->Map(0, nullptr, &m)))
+            g_qmapped = (const UINT64*)m;
+        else g_qh = nullptr;
+    }
+    g_ok = g_why.empty();
+    if (g_ok)
+    {
+        const std::string arch = deviceArch();
+        g_gpuDesc = "HIP " + arch;
+        g_gen = arch.rfind("gfx12", 0) == 0 ? 4 : arch.rfind("gfx11", 0) == 0 ? 3 : arch.rfind("gfx103", 0) == 0 ? 2 : 0;
+        if (FILE* f = nullptr; fopen_s(&f, (g_dir + "\\hip\\flavour.txt").c_str(), "rb") == 0 && f)
+        { char b[16] = {}; fread(b, 1, sizeof b - 1, f); fclose(f); g_wmma = !strncmp(b, "wmma", 4); }
+    }
+    if (g_ok) TraceF("x4r: HIP backend ready on %s (code objects in %s\\hip)", deviceArch(), g_dir.c_str());
+    else TraceF("x4r: HIP backend unavailable: %s", g_why.c_str());
+    if (FILE* f = nullptr; fopen_s(&f, (g_dir + "\\hip-status.txt").c_str(), "wb") == 0 && f)
+    { fprintf(f, "hip=%s\narch=%s\nreason=%s\n", g_ok ? "ready" : "unavailable", g_ok ? deviceArch() : "", g_why.c_str()); fclose(f); }
+}
