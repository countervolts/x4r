+void STDMETHODCALLTYPE h_CopyDescs(ID3D12Device* d, UINT nd, const D3D12_CPU_DESCRIPTOR_HANDLE* ds, const UINT* dn, UINT ns, const D3D12_CPU_DESCRIPTOR_HANDLE* ss, const UINT* sn, D3D12_DESCRIPTOR_HEAP_TYPE t)
+{
+    if (t == D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV)
