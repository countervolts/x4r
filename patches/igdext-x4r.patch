+// records copies of one bound resource into a readback buffer; state is the one the binding implies
+void CopyOut(ID3D12GraphicsCommandList* l, ID3D12Resource* r, D3D12_RESOURCE_STATES state, const std::string& name, FILE* man, std::vector<Pending>& out, UINT64 off = 0, UINT64 len = 0)
+{
+    D3D12_RESOURCE_DESC d = r->GetDesc();
+    D3D12_HEAP_PROPERTIES hp = {}; D3D12_HEAP_FLAGS hf; r->GetHeapProperties(&hp, &hf);
+    const bool barrier = hp.Type == D3D12_HEAP_TYPE_DEFAULT || hp.Type == D3D12_HEAP_TYPE_CUSTOM;
+    UINT64 bytes = 0; D3D12_PLACED_SUBRESOURCE_FOOTPRINT fp = {};
+    if (d.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) { if (!len) { off = 0; len = d.Width; } bytes = len; }
+    else { UINT rows; UINT64 rs; g_dev->GetCopyableFootprints(&d, 0, 1, 0, &fp, &rows, &rs, &bytes); }
+    D3D12_HEAP_PROPERTIES rh = {}; rh.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {}; rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; rd.Width = bytes; rd.Height = rd.DepthOrArraySize = rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ID3D12Resource* rb = nullptr;
+    if (FAILED(o_CreateCommitted(g_dev, &rh, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, __uuidof(ID3D12Resource), (void**)&rb))) return;
+    D3D12_RESOURCE_BARRIER b = {}; b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition = {r, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, state, D3D12_RESOURCE_STATE_COPY_SOURCE};
+    if (barrier) l->ResourceBarrier(1, &b);
+    if (d.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) l->CopyBufferRegion(rb, 0, r, off, bytes);
+    else
+    {
+        D3D12_TEXTURE_COPY_LOCATION dst = {}, src = {};
+        dst.pResource = rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; dst.PlacedFootprint = fp;
+        src.pResource = r; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; src.SubresourceIndex = 0;
+        l->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+    }
+    std::swap(b.Transition.StateBefore, b.Transition.StateAfter);
+    if (barrier) l->ResourceBarrier(1, &b);
+    out.push_back({name, rb, bytes});
+    if (man)
+    {
+        if (d.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) fprintf(man, "%s buffer bytes %llu offset %llu res %p\n", name.c_str(), (unsigned long long)bytes, (unsigned long long)off, (void*)r);
+        else fprintf(man, "%s texture %llux%u fmt %d rowpitch %u bytes %llu res %p\n", name.c_str(), (unsigned long long)d.Width, d.Height, (int)d.Format,
+                     fp.Footprint.RowPitch, (unsigned long long)bytes, (void*)r);
+    }
+}
