+// buffer holding a GPU VA (exact start or inside): (resource, offset)
+std::pair<ID3D12Resource*, UINT64> BufferAt(UINT64 va)
+{
+    auto it = g_bufs.upper_bound(va);
+    if (it == g_bufs.begin()) return {nullptr, 0};
+    --it;
+    if (va >= it->first + it->second.first) return {nullptr, 0};
+    return {it->second.second, va - it->first};
+}
