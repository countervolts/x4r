+// ID3D12Device::CreateHeap (HIP backend): libxess' DEFAULT heaps become shared, so its placed buffers can be imported
+using PFN_CreateResHeap = HRESULT(STDMETHODCALLTYPE*)(ID3D12Device*, const D3D12_HEAP_DESC*, REFIID, void**);
+PFN_CreateResHeap o_CreateResHeap;
+HRESULT STDMETHODCALLTYPE h_CreateResHeap(ID3D12Device* dv, const D3D12_HEAP_DESC* d, REFIID riid, void** pp)
+{
+    const bool xess = HipFromXess(_ReturnAddress());
