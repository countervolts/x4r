+bool HipCopy(ID3D12GraphicsCommandList* l, ID3D12Resource* d, UINT64 doff, ID3D12Resource* s, UINT64 soff, UINT64 n);
+void STDMETHODCALLTYPE h_SetPSO(ID3D12GraphicsCommandList* l, ID3D12PipelineState* p)
+{
