+// ---- native Windows (not Wine): XeSS takes its XMX path only on an Intel adapter. No dxvk.conf there: the adapter's GetDesc*
+// methods report Intel's vendor id (and an Arc A770's device id) to calls made from libxess.dll, the rest of the game sees the
+// real GPU. XeSS finds this shim through INTC_ALT_DRIVER_EXTENSIONS_PATH (the folder with igdext64.dll, a copy of this DLL).
+bool UnderWine()
+{
+    HMODULE n = GetModuleHandleA("ntdll.dll");
+    return n && GetProcAddress(n, "wine_get_version");
+}
+
+namespace spoof
+{
+using Desc0 = HRESULT(STDMETHODCALLTYPE*)(IDXGIAdapter*, DXGI_ADAPTER_DESC*);
+using Desc1 = HRESULT(STDMETHODCALLTYPE*)(IDXGIAdapter1*, DXGI_ADAPTER_DESC1*);
+using Desc2 = HRESULT(STDMETHODCALLTYPE*)(IDXGIAdapter2*, DXGI_ADAPTER_DESC2*);
+using Desc3 = HRESULT(STDMETHODCALLTYPE*)(IDXGIAdapter4*, DXGI_ADAPTER_DESC3*);
+Desc0 g0 = nullptr; Desc1 g1 = nullptr; Desc2 g2 = nullptr; Desc3 g3 = nullptr;
+constexpr UINT kVendor = 0x8086, kDevice = 0xE20B;   // Intel Arc A770 (XMX)
+
+bool FromXess(void* ret)
+{
+    HMODULE m = nullptr;
+    if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, static_cast<LPCSTR>(ret), &m)) return false;
+    char p[MAX_PATH] = {};
+    GetModuleFileNameA(m, p, MAX_PATH);
+    const char* b = strrchr(p, '\\');
+    return b && _stricmp(b + 1, "libxess.dll") == 0;
+}
+template <class D> void Patch(D* d, void* ret) { if (FromXess(ret)) { d->VendorId = kVendor; d->DeviceId = kDevice; } }
+HRESULT STDMETHODCALLTYPE GetDesc0(IDXGIAdapter* a, DXGI_ADAPTER_DESC* d) { HRESULT r = g0(a, d); if (SUCCEEDED(r)) Patch(d, _ReturnAddress()); return r; }
+HRESULT STDMETHODCALLTYPE GetDesc1(IDXGIAdapter1* a, DXGI_ADAPTER_DESC1* d) { HRESULT r = g1(a, d); if (SUCCEEDED(r)) Patch(d, _ReturnAddress()); return r; }
+HRESULT STDMETHODCALLTYPE GetDesc2(IDXGIAdapter2* a, DXGI_ADAPTER_DESC2* d) { HRESULT r = g2(a, d); if (SUCCEEDED(r)) Patch(d, _ReturnAddress()); return r; }
+HRESULT STDMETHODCALLTYPE GetDesc3(IDXGIAdapter4* a, DXGI_ADAPTER_DESC3* d) { HRESULT r = g3(a, d); if (SUCCEEDED(r)) Patch(d, _ReturnAddress()); return r; }
+
+template <class F> void Hook(void** vt, int slot, F fn, F& orig)
+{
+    if (vt[slot] == reinterpret_cast<void*>(fn)) return;
+    DWORD old;
+    if (!VirtualProtect(&vt[slot], sizeof(void*), PAGE_READWRITE, &old)) return;
+    orig = reinterpret_cast<F>(vt[slot]);
+    vt[slot] = reinterpret_cast<void*>(fn);
+    VirtualProtect(&vt[slot], sizeof(void*), old, &old);
+}
+
+// IDXGIAdapter vtable: GetDesc 8, GetDesc1 10 (IDXGIAdapter1), GetDesc2 11 (IDXGIAdapter2), GetDesc3 18 (IDXGIAdapter4)
+void Install()
+{
+    HMODULE dxgi = LoadLibraryA("dxgi.dll");
+    auto create = dxgi ? reinterpret_cast<HRESULT(WINAPI*)(REFIID, void**)>(GetProcAddress(dxgi, "CreateDXGIFactory1")) : nullptr;
+    IDXGIFactory1* f = nullptr;
+    if (!create || FAILED(create(__uuidof(IDXGIFactory1), reinterpret_cast<void**>(&f)))) { TraceF("x4r: no DXGI factory: vendor id not spoofed"); return; }
+    IDXGIAdapter1* a = nullptr;
+    for (UINT i = 0; f->EnumAdapters1(i, &a) == S_OK; ++i)
+    {
+        void** vt = *reinterpret_cast<void***>(a);
+        Hook(vt, 8, &GetDesc0, g0);
+        Hook(vt, 10, &GetDesc1, g1);
+        IDXGIAdapter4* a4 = nullptr;
+        if (SUCCEEDED(a->QueryInterface(__uuidof(IDXGIAdapter4), reinterpret_cast<void**>(&a4))))
+        {
+            void** vt4 = *reinterpret_cast<void***>(a4);
+            Hook(vt4, 11, &GetDesc2, g2);
+            Hook(vt4, 18, &GetDesc3, g3);
+            a4->Release();
+        }
+        a->Release();
+    }
+    f->Release();
+    TraceF("x4r: native Windows: XeSS sees vendor %04x device %04x", kVendor, kDevice);
+}
+} // namespace spoof
+
+// DllMain: locate the runtime folder (<dll folder>\x4r, or X4R_DIR set by the plugin instance), falling back to C:\x4r.
+// Returns true when this DLL was loaded as the x4r.asi plugin (it then only installs itself and stays idle).
+extern "C" bool X4rInit(HMODULE self)
+{
+    char p[MAX_PATH] = {};
+    char env[MAX_PATH] = {};
+    if (GetEnvironmentVariableA("X4R_DIR", env, MAX_PATH) && DirExists(env)) { g_dir = env; return false; }
+    if (!GetModuleFileNameA(self, p, MAX_PATH)) return false;
+    const std::string path = p;
+    char* slash = strrchr(p, '\\');
+    if (!slash) return false;
+    *slash = 0;
+    std::string cand = std::string(p) + "\\x4r";
+    if (DirExists(std::string(p) + "\\dxil") || DirExists(std::string(p) + "\\hip")) cand = p;   // release layout: <game>\x4r\x4r.asi beside its kernels
+    if (DirExists(cand)) g_dir = cand;
+    const size_t n = path.size();
+    const bool asi = n > 4 && _stricmp(path.c_str() + n - 4, ".asi") == 0;
+    if (asi && DirExists(cand))
+    {
+        SetEnvironmentVariableA("X4R_DIR", cand.c_str());          // the copy in system32 finds the kernels through this
+        SelectOverrides();   // as early as the plugin loads: vkd3d-proton only sees VKD3D_SHADER_OVERRIDE if it is set before it initialises
+        if (IniValue("Trace") == "true") SetEnvironmentVariableA("IGDEXT_TRACE", "1");   // x4r.ini: per-kernel GPU times in C:\\igdext_trace.log (inside the prefix)
+        if (UnderWine()) InstallFromPlugin(path);
+        else SetEnvironmentVariableA("INTC_ALT_DRIVER_EXTENSIONS_PATH", cand.c_str());   // native: <x4r>\igdext64.dll is the shim
+    }
+    return asi;
+}
+
+// OptiScaler (or all4r) calls this after loading x4r.asi, outside the loader lock: the native vendor id spoof needs DXGI
+extern "C" __declspec(dllexport) void InitializeASI()
+{
+    static bool done = false;
+    if (done || UnderWine()) return;
+    done = true;
+    spoof::Install();
+}
+
+// 1 on an x4r install (the ANV self-test does not apply), 0 without the x4r runtime (upstream behaviour). A game whose
+// XeSS has kernels we did not translate does not fall back to DP4a: the pipeline creation fails (X4rKernelFailed).
+extern "C" int X4rGate()
+{
+    if (!DirExists(g_dir + "\\dxil") && !DirExists(g_dir + "\\hip")) return 0;   // dxil\: translated DXIL (Proton), hip\: code objects (native Windows)
+    HMODULE m = GetModuleHandleA("libxess.dll");
+    char path[MAX_PATH];
+    if (m && GetModuleFileNameA(m, path, MAX_PATH))
+    {
+        DWORD h = 0, n = GetFileVersionInfoSizeA(path, &h);
+        std::vector<char> blob(n ? n : 1);
+        VS_FIXEDFILEINFO* fi = nullptr; UINT len = 0;
+        if (n && GetFileVersionInfoA(path, 0, n, blob.data()) && VerQueryValueA(blob.data(), "\\", (void**)&fi, &len) && fi)
+        {
+            char have[64]; snprintf(have, sizeof have, "%u.%u.%u.%u", HIWORD(fi->dwFileVersionMS), LOWORD(fi->dwFileVersionMS), HIWORD(fi->dwFileVersionLS), LOWORD(fi->dwFileVersionLS));
+            g_xessVer = have;
+        }
+    }
+    return 1;
+}
+
+// A CM kernel without a translation (other XeSS version, translation missing or rejected by the driver): count it and
+// let the caller fail the pipeline, so the problem shows up as an XeSS error and in status.txt, never as noise or a silent fallback.
+extern "C" void X4rKernelFailed(unsigned long long kernelHash, const char* why)
+{
+    ++g_failed;
+    if (FILE* f = nullptr; fopen_s(&f, (g_dir + "\\failed-kernels.txt").c_str(), "ab") == 0 && f) { fprintf(f, "%016llx %s\n", kernelHash, why); fclose(f); }
+    TraceF("x4r: FAILED kernel %016llx: %s (XeSS library %s, runtime expects %s)", kernelHash, why, g_xessVer.c_str(), IniValue("XessVersion").c_str());
+    WriteStatus(0);
+}
